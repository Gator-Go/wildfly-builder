        ADMIN_EVENTS("AdminEvents",EventManagerServlet.class,"doHome","1","0","event/EventList.jsp","adminIndex.jsp"),
        ADMIN_EVENTS_ADD_EVENT("AddEvent",EventManagerServlet.class,"doAddAdminEvent","1","0","event/EventAdd.jsp","adminIndex.jsp"),
        ADMIN_EVENTS_ADD_EVENT_ACTION("AddEventAction",EventManagerServlet.class,"doAddAdminEventAction","1","0","event/EventAdd.jsp","adminIndex.jsp"),
        ADMIN_EVENTS_EDIT_EVENT("EditEvent",EventManagerServlet.class,"doEditAdminEvent","1","0","event/EventEdit.jsp","adminIndex.jsp"),
        ADMIN_EVENTS_EDIT_EVENT_ACTION("EditEventAction",EventManagerServlet.class,"doEditAdminEventAction","1","0","event/EventEdit.jsp","adminIndex.jsp"),
        ADMIN_EVENTS_DELETE_EVENT("DeleteEvent",EventManagerServlet.class,"doDeleteAdminEvent","1","0","event/EventDelete.jsp","adminIndex.jsp"),
        ADMIN_EVENTS_DELETE_EVENT_ACTION("DeleteEventAction",EventManagerServlet.class,"doDeleteAdminEventAction","1","0","event/EventDelete.jsp","adminIndex.jsp"),
        ADMIN_EVENTS_FIRESCHEDULE_EVENT("FireEvent",EventManagerServlet.class,"doFireEvent","1","0","event/EventFire.jsp","adminIndex.jsp"),
        ADMIN_EVENTS_FIRE_EVENT("FireEvent",EventManagerServlet.class,"doFireEvent","1","0","event/EventFire.jsp","adminIndex.jsp"),
        ADMIN_EVENTS_FIRE_EVENT_ACTION("FireEventAction",EventManagerServlet.class,"doFireEventAction","1","0","event/EventFire.jsp","adminIndex.jsp"),
        ADMIN_EVENTS_SCHEDULE_EVENT("ScheduleEvent",EventManagerServlet.class,"doScheduleEvent","1","0","event/EventSchedule.jsp","adminIndex.jsp"),
        ADMIN_EVENTS_SCHEDULE_EVENT_ACTION("ScheduleEventAction",EventManagerServlet.class,"doScheduleEventAction","1","0","event/EventSchedule.jsp","adminIndex.jsp"),

        ADMIN_SUBSCRIPT("AdminSubscriptions",SubscriptionServlet.class,"doHome","1","1","subscription/SubscriptList.jsp","adminIndex.jsp"),
        ADMIN_SUBSCRIPT_VIEW("ViewSubscription",SubscriptionServlet.class,"doViewSubscription","1","1","subscription/SubscriptView.jsp","adminIndex.jsp"),
        ADMIN_SUBSCRIPT_ADD("AddSubscription",SubscriptionServlet.class,"doAddSubscription","1","1","subscription/SubscriptAdd.jsp","adminIndex.jsp"),
        ADMIN_SUBSCRIPT_ADD_SELECT("AddSubscriptionSelect",SubscriptionServlet.class,"doAddSubscriptionSelect","1","1","subscription/SubscriptAdd.jsp","adminIndex.jsp"),
        ADMIN_SUBSCRIPT_ADD_ACTION("AddSubscriptionAction",SubscriptionServlet.class,"doAddSubscriptionAction","1","1","subscription/SubscriptAdd.jsp","adminIndex.jsp"),
        ADMIN_SUBSCRIPT_EDIT("EditSubscription",SubscriptionServlet.class,"doEditSubscription","1","1","subscription/SubscriptEdit.jsp","adminIndex.jsp"),
        ADMIN_SUBSCRIPT_EDIT_ACTION("EditSubscriptionAction",SubscriptionServlet.class,"doEditSubscriptionAction","1","1","subscription/SubscriptEdit.jsp","adminIndex.jsp"),
