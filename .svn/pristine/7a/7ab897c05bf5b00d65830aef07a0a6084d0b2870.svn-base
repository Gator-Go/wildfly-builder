keytool -printcert -file berry.cer
ip addr show
sudo -u www-data vi $JBOSS_HOME/standalone/configuration/standalone.xml
cd $JBOSS_HOME
sudo -u www-data bin/add-user.sh 
then put the raspberry IP in the public and management interfaces (toward the bottom) and add the Internet IP from the router setup to the com.pojomax.sync.app.http-root
sudo -u www-data $JBOSS_HOME/bin/standalone.sh

su

(21) To enable wildfly as a linux service:
sudo cp $JBOSS_HOME/docs/contrib/scripts/systemd/wildfly.service /etc/systemd/system
sudo mkdir /etc/wildfly
sudo cp $JBOSS_HOME/docs/contrib/scripts/systemd/wildfly.conf /etc/wildfly
set 'WILDFLY_BIND' in wildfly.conf to be ip address 
change 'User' in wildfly.service if necessary
sudo systemctl enable wildfly.service
sudo systemctl start wildfly.service

(22) to create users
add-user   a-admin   ron/gator

localhost:9990/console/index.html
http://127.0.0.1:9990

