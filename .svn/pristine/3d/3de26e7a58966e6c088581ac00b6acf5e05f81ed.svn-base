  <appFunc funcKey='___JSP_REPORT_ACTIVATE_FUNCTION___' tblOrder='forward' codeNbr='Once' codeType='Report'>
    <func indent='0'>LLLLLc:set var="tabIdx" scope="session" value="LLLLL%= tabIdx %GGGGG"/GGGGG</func>
    <func indent='0'>LLLLLc:if test="MMMMM{ tabIdx == ___JSP_SEQ___ }"GGGGG</func>
    <func indent='2'>MMMMM( "#reportTabs" ).tabs({</func>
    <func indent='4'>active: LLLLL%= tabIdx2 %GGGGG,</func>
    <func indent='0'></func>
    <func indent='4'>beforeActivate: function (event, ui) {</func>
    <func indent='6'>var tabId = ui.newPanel.attr('id');</func>
    <func indent='0'></func>
    <func indent='6'>if (tabId == "ReportList"){</func>
    <func indent='8'>document.location = 'LLLLLc:out value="MMMMM{ReportListURL}" /GGGGG';</func>
    <func indent='8'>return false;</func>
    <func indent='6'>}</func>
    <func indent='6'>if (tabId == "GenReport"){</func>
    <func indent='8'>document.location = 'LLLLLc:out value="MMMMM{GenerateReportURL}" /GGGGG';</func>
    <func indent='8'>return false;</func>
    <func indent='6'> }</func>
    <func indent='4'>}</func>
    <func indent='2'>});</func>
    <func indent='2'>LLLLLc:if test="MMMMM{ role == 'GUEST' }"GGGGG</func>
    <func indent='4'>MMMMM('#GenReportTab').hide();</func>
    <func indent='2'>LLLLL/c:ifGGGGG</func>
    <func indent='0'>LLLLL/c:ifGGGGG</func>
  </appFunc>

