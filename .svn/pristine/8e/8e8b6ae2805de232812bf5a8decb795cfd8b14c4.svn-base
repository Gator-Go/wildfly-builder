<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="ISO-8859-1"%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>

<%
String httpRoot = System.getProperty("com.pojomax.sync.app.http-root");
%>

<div class='pojo-section'>
      <div class='pojo-section-header'>Home Page</div>
      <div class='pojo-section-body'>
	<H3>Your Apps</H3><br>

	<a href='<%= httpRoot %>/social/do?op=Home'>
	   <img border="0" src="resources/gfx/social logo.png" alt="Social Home" />
	</a>

	<br><br>

	<hr>

	<br>

	<H3>Link To User's Guide And Setup Guide</H3><br>

	<a href='http://homeberrycloud.com' target='_blank'>
	   <img border="0" src="resources/gfx/social_help.png" alt="Home Berry Cloud Inc." /><br>
	</a>

      </div>
</div>
