
package ppp.ppp.ppp.servlet;

import ppp.ppp.ppp.entity.AdminEvent;
import ppp.ppp.ppp.entity.EventSchedule;
import ppp.ppp.ppp.entity.EventParameter;
import ppp.ppp.ppp.service.EventService;
import ppp.ppp.ppp.servlet.helper.EventDataHelper;
import ppp.ppp.ppp.servlet.helper.EventErrorHelper;
import ppp.ppp.ppp.servlet.helper.AdminEventFmt;
import ppp.ppp.ppp.servlet.helper.ParameterFmt;
import ppp.ppp.ppp.event.FireEvent;
import ppp.ppp.ppp.event.EventScheduler;

import javax.enterprise.context.RequestScoped;
import javax.enterprise.event.Event;
import javax.ejb.ScheduleExpression;
import javax.inject.Inject;
import javax.servlet.RequestDispatcher;
import javax.servlet.ServletException;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import java.io.IOException;

import java.util.logging.Logger;
import java.util.List;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.Map;

/**
 * Servlet implementation class ServiceLogManager
 */
@RequestScoped
public class EventManagerServlet extends HttpServlet {
    private static final long serialVersionUID = 1L;

    @Inject
    private Logger log;

    @Inject
    private EventService eventService;

    @Inject
    private EventDataHelper eventDataHelper;

    @Inject
    private EventErrorHelper eventErrorHelper;

    @Inject
    private FireEvent fireEvent;

    @Inject
    private EventScheduler eventScheduler;


    /**
     * Default constructor.
     */
    public EventManagerServlet() {
        // TODO Auto-generated constructor stub
    }



    public void doHome(HttpServletRequest req, HttpServletResponse resp) throws ServletException, IOException {

        String subOp = req.getParameter("subop");
        if (subOp == null)
            subOp = "new";

        List<AdminEvent> adminEvents = eventService.findAllAdminEvents();
        if (adminEvents == null || adminEvents.size() == 0)
        {
            String alertMsg = "AdminEvent search and results returned null or 0 adminEvents";
            log.warning(alertMsg);
            req.setAttribute("op", "AdminEvents");
            return;
        }

        int rowsToPage = 20;
        Integer page = new Integer(1);
        String pageStr = (String) req.getSession().getAttribute("eventPage");
        if (pageStr != null)
           page = new Integer(pageStr);
        int nbrOfPages = adminEvents.size() / rowsToPage;
        if (adminEvents.size() % rowsToPage > 0)
           nbrOfPages++;

        if (subOp.equals("nextPage")) {
           page = new Integer(page.intValue() + 1);
           req.getSession().setAttribute("eventPage", page.toString());
        }
        if (subOp.equals("previousPage")) {
           page = new Integer(page.intValue() - 1);
           req.getSession().setAttribute("eventPage", page.toString());
        }

        String pageInfo = adminEvents.size() + " Rows - Page " + page.toString() + " of " + nbrOfPages;
        req.setAttribute("pageInfo", pageInfo);

        if (page.intValue() <  nbrOfPages)
           req.setAttribute("nextFlag", "true");
        if (page.intValue() >  1)
           req.setAttribute("previousFlag", "true");

        List<AdminEventFmt> adminEventPage = eventDataHelper.loadAdminEventPage(adminEvents, page.intValue(), rowsToPage, adminEvents.size());
        req.setAttribute("adminEvents", adminEventPage);
        req.setAttribute("op", "AdminEvents");
    }


   /**
    * The doAddAdminEvent method calls the AdminEvent add web page.
    * It loads default data to the web page.
    *
    * @param req A HttpServletRequest object containing the request data.
    * @param resp A HttpServletResponse object containing the response data.
    */
    public void doAddAdminEvent(HttpServletRequest req, HttpServletResponse resp) throws ServletException, IOException {

        eventDataHelper.loadDefaultEventData(req);
        req.setAttribute("opAction", "AddEventAction");
        req.setAttribute("opBack", "AdminEvents");
        req.setAttribute("op", "AddEvent");
    }

   /**
    * The doAddAdminEventAction method creates the AdminEvent from add web page data.
    *
    * @param req A HttpServletRequest object containing the request data.
    * @param resp A HttpServletResponse object containing the response data.
    */
    public void doAddAdminEventAction(HttpServletRequest req, HttpServletResponse resp) throws ServletException, IOException {

        if (eventErrorHelper.checkAdminEventData(req) == true)
        {
            eventDataHelper.loadEventDataFromReq(req);
            req.setAttribute("opAction", "AddEventAction");
            req.setAttribute("opBack", "AdminEvents");
            req.setAttribute("op", "AddEvent");
            return;
        }

        AdminEvent adminEvent = new AdminEvent();
        eventDataHelper.loadAdminEventAdd(adminEvent, req);

        Long adminEventId = eventService.addAdminEvent(adminEvent);

        req.setAttribute("msg", "Event Record Added, ID = " + adminEventId);
        doHome(req, resp);
    }


   /**
    * The doEditAdminEvent method calls the AdminEvent add web page.
    * It loads default data to the web page.
    *
    * @param req A HttpServletRequest object containing the request data.
    * @param resp A HttpServletResponse object containing the response data.
    */
    public void doEditAdminEvent(HttpServletRequest req, HttpServletResponse resp) throws ServletException, IOException {

        Long adminEventId = new Long(req.getParameter("id"));
        AdminEvent adminEvent = eventService.getAdminEvent(adminEventId);
        eventDataHelper.loadEventFormData(adminEvent, req);

        req.setAttribute("opAction", "EditEventAction");
        req.setAttribute("opBack", "AdminEvents");
        req.setAttribute("op", "EditEvent");
    }

   /**
    * The doEditAdminEventAction method creates the AdminEvent from add web page data.
    *
    * @param req A HttpServletRequest object containing the request data.
    * @param resp A HttpServletResponse object containing the response data.
    */
    public void doEditAdminEventAction(HttpServletRequest req, HttpServletResponse resp) throws ServletException, IOException {

        if (eventErrorHelper.checkAdminEventData(req) == true)
        {
            eventDataHelper.loadEventDataFromReq(req);
            req.setAttribute("opAction", "EditEventAction");
            req.setAttribute("opBack", "AdminEvents");
            req.setAttribute("op", "EditEvent");
            return;
        }

        Long adminEventId = new Long(req.getParameter("id"));
        AdminEvent adminEvent = eventService.getAdminEvent(adminEventId);

        String result = eventDataHelper.deleteUpdateParameters(adminEvent, req);
        if (result.equals("Success"))
        {
          eventDataHelper.loadAdminEventUpdate(adminEvent, req);
          result = eventService.editAdminEvent(adminEvent);
        }
        else
        {
          req.setAttribute("msg", "Event Parameter Edit Error " + result);
          log.warning("result = " + result);
          doHome(req, resp);
          return;
        }

        if (!result.equals("Success"))
        {
            req.setAttribute("msg", "Event Edit Error " + result);
            log.warning("result = " + result);
        }
        else
            req.setAttribute("msg", "Event Record Edited Successfully");

        doHome(req, resp);
    }


   /**
    * The doDeleteAdminEvent method calls the AdminEvent delete web page.
    * It loads AdminEvent data to the web page.
    *
    * @param req A HttpServletRequest object containing the request data.
    * @param resp A HttpServletResponse object containing the response data.
    */
    public void doDeleteAdminEvent(HttpServletRequest req, HttpServletResponse resp) throws ServletException, IOException {

        Long adminEventId = new Long(req.getParameter("id"));
        AdminEvent adminEvent = eventService.getAdminEvent(adminEventId);
        eventDataHelper.loadEventFormData(adminEvent, req);

        req.setAttribute("opAction", "DeleteEventAction");
        req.setAttribute("opBack", "AdminEvents");
        req.setAttribute("op", "DeleteEvent");
    }

   /**
    * The doDeleteAdminEventAction method deletes the AdminEvent from delete web page data.
    *
    * @param req A HttpServletRequest object containing the request data.
    * @param resp A HttpServletResponse object containing the response data.
    */
    public void doDeleteAdminEventAction(HttpServletRequest req, HttpServletResponse resp) throws ServletException, IOException {

        Long adminEventId = new Long(req.getParameter("id"));

        String result = eventService.deleteAdminEvent(adminEventId);
        if (!result.equals("Success"))
        {
            req.setAttribute("msg", "Event Delete Error " + result);
            log.warning("result = " + result);
        }
        else
            req.setAttribute("msg", "Event Record Deleted Successfully");

        doHome(req, resp);
    }


    public void doFireEvent(HttpServletRequest req, HttpServletResponse resp) throws ServletException, IOException {

        Long adminEventId = new Long(req.getParameter("id"));
        AdminEvent adminEvent = eventService.getAdminEvent(adminEventId);

        eventDataHelper.loadEventFormData(adminEvent, req);

        req.setAttribute("opAction", "FireEventAction");
        req.setAttribute("opBack", "AdminEvents");
        req.setAttribute("op", "FireEvent");
    }


    public void doFireEventAction(HttpServletRequest req, HttpServletResponse resp) throws ServletException, IOException {

        if (eventErrorHelper.checkAdminEventFire(req) == true)
        {
            eventDataHelper.loadEventDataFromReq(req);
            req.setAttribute("opAction", "FireEventAction");
            req.setAttribute("opBack", "AdminEvents");
            req.setAttribute("op", "FireEvent");
            return;
        }

        Long adminEventId = new Long(req.getParameter("id"));
        AdminEvent adminEvent = eventService.getAdminEvent(adminEventId);

        Map<String, String> parameterData = new HashMap<String, String>();
        eventDataHelper.loadParameterMap(req, parameterData);

        fireEvent.fireEvent(adminEvent.getName(), parameterData);

        doHome(req, resp);
    }


    public void doScheduleEvent(HttpServletRequest req, HttpServletResponse resp) throws ServletException, IOException {

        Long adminEventId = new Long(req.getParameter("id"));
        AdminEvent adminEvent = eventService.getAdminEvent(adminEventId);

        if (adminEvent.getEventSchedule() == null)
           eventDataHelper.loadDefaultScheduleEventData(req, adminEvent);
        else
           eventDataHelper.loadScheduleEventData(req, adminEvent);

        req.setAttribute("opAction", "ScheduleEventAction");
        req.setAttribute("opBack", "AdminEvents");
        req.setAttribute("op", "ScheduleEvent");
    }


    public void doScheduleEventAction(HttpServletRequest req, HttpServletResponse resp) throws ServletException, IOException {

        Long adminEventId = new Long(req.getParameter("id"));
        AdminEvent adminEvent = eventService.getAdminEvent(adminEventId);

        if (eventErrorHelper.checkAdminEventSchedule(req) == true)
        {
            eventDataHelper.loadEventScheduleFromReq(req);
            req.setAttribute("opAction", "ScheduleEventAction");
            req.setAttribute("opBack", "AdminEvents");
            req.setAttribute("op", "ScheduleEvent");
            return;
        }

        EventSchedule eventSchedule = new EventSchedule();
        eventDataHelper.loadAdminEventSchedule(eventSchedule, req, adminEvent);

        if (adminEvent.getEventSchedule() == null) {
           Long eventScheduleId = eventService.addEventSchedule(eventSchedule);
           req.setAttribute("msg", "Event Schedule Added, ID = " + eventScheduleId);
        } else {
           eventSchedule.setId(adminEvent.getEventSchedule().getId());
           String result = eventService.editEventSchedule(eventSchedule);

           if (!result.equals("Success"))
           {
               req.setAttribute("msg", "Event Schedule Edit Error " + result);
               log.warning("result = " + result);
           }
           else
               req.setAttribute("msg", "Event Schedule Edited Successfully");
        }
	if (eventSchedule.getEnabled().booleanValue() == true) {
	    if (!eventSchedule.getSchedule().equals("* * * * * * *")) {

		String[] parts = eventSchedule.getSchedule().split(" ");

		if (!parts[0].equals("*")) {
        	  ScheduleExpression schedule = new ScheduleExpression().second(parts[0])
		  .minute(parts[1]).hour(parts[2]).dayOfMonth(parts[3]).month(parts[4])
		  .dayOfWeek(parts[5]).year(parts[6]);
   		  eventScheduler.scheduleEvent(schedule, eventSchedule.getAdminEvent().getName());

		} else if (!parts[1].equals("*")){
        	  ScheduleExpression schedule = new ScheduleExpression()
		  .minute(parts[1]).hour(parts[2]).dayOfMonth(parts[3]).month(parts[4])
		  .dayOfWeek(parts[5]).year(parts[6]);
   		  eventScheduler.scheduleEvent(schedule, eventSchedule.getAdminEvent().getName());

		} else if (!parts[2].equals("*")){
        	  ScheduleExpression schedule = new ScheduleExpression()
		  .hour(parts[2]).dayOfMonth(parts[3]).month(parts[4])
		  .dayOfWeek(parts[5]).year(parts[6]);
   		  eventScheduler.scheduleEvent(schedule, eventSchedule.getAdminEvent().getName());

		} else if (!parts[5].equals("*")){
        	  ScheduleExpression schedule = new ScheduleExpression()
		  .dayOfMonth(parts[3]).month(parts[4])
		  .dayOfWeek(parts[5]).year(parts[6]);
   		  eventScheduler.scheduleEvent(schedule, eventSchedule.getAdminEvent().getName());

		} else if (!parts[3].equals("*")){
        	  ScheduleExpression schedule = new ScheduleExpression()
		  .dayOfMonth(parts[3]).month(parts[4]).year(parts[6]);
   		  eventScheduler.scheduleEvent(schedule, eventSchedule.getAdminEvent().getName());

		} else if (!parts[4].equals("*")){
        	  ScheduleExpression schedule = new ScheduleExpression()
		  .month(parts[4]).year(parts[6]);
   		  eventScheduler.scheduleEvent(schedule, eventSchedule.getAdminEvent().getName());

		} else {
        	  ScheduleExpression schedule = new ScheduleExpression().year(parts[6]);
   		  eventScheduler.scheduleEvent(schedule, eventSchedule.getAdminEvent().getName());
		}
	    }
	}

        doHome(req, resp);
    }



}
