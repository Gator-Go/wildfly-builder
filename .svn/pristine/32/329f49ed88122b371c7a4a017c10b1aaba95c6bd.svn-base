
<%@ page language="java" contentType="text/html; charset=UTF-8"     pageEncoding="ISO-8859-1"%>
<%@ page import="ppp.ppp.ppp.report.ConstRpt" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>

<%
String httpRoot = System.getProperty("com.pojomax.sync.app.http-root");
String rptDir = System.getProperty("com.pojomax.sync.app.report.dir");
%>


<c:url value="do" var="previousURL">
  <c:param name="op" value="RptListList" />
  <c:param name="opSub" value="previousPage" />
</c:url>
<c:url value="do" var="nextURL">
  <c:param name="op" value="RptListList" />
  <c:param name="opSub" value="nextPage" />
</c:url>

<div class='pojo-section'>
<div class='pojo-section-header'>Report List</div>
<div class='pojo-section-body'>

<p>
   <label style="color: green;width: 100%;text-align: left;">${msg}</label> 
</p>



<c:if test="${!empty previousFlag}">
  &nbsp;&nbsp;
  <a href='<c:out value="${previousURL}" />'>
    <button class='btnPrevious'>Prev</button>
  </a>
</c:if>

<c:if test="${!empty nextFlag}">
  &nbsp;&nbsp;
  <a href='<c:out value="${nextURL}" />'>
    <button class='btnNext'>Next</button>
  </a>
</c:if>

<br><font class="Verdana"><b>${pageInfo}</b></font>

<table class="pojo_tablestyle">

<thead>
<tr>
  <th valign="top" width="10%">Action</th>
  <th valign="top" width="10%">Report Name</th>

</tr>
</thead>

<tbody>

<c:forEach items="${rptListing}" var="item">
        
      <tr>

        <c:url value="do" var="deleteURL">
            <c:param name="op"   value="RptListDelete" />
            <c:param name="id"   value="${item.id}" />
        </c:url>

      <td>
          <c:if test="${!empty admin}">
            <a href='<c:out value="${deleteURL}" />'><button class='btnDeleteIcon'>Delete</button></a>
          </c:if>
          <button class='btnDownloadIcon' id="download" type="button" onclick='goDownloadReport("${item.rptName}");'>Download Report</button>
      </td>
    <td> <strong style="font-size: 15px;"> ${item.rptName} </strong> </td>

	</tr>

</c:forEach>

</tbody>

</table>

<form id="formDownloadReport" action="do" method="POST">

    <input type='hidden' id="opDownloadReport" name='op' value="FileDownload">
    <input type='hidden' id="opFileName" name='FileName' value="">
    <input type="hidden" id="opFilePath" name='FilePath' value="" />

</form>

</div>
</div>

<script>

  function goDownloadReport(rptName)
  {

    var filePath = "<%= rptDir %>" + rptName;

    $('#opFileName').val(rptName);
    $('#opFilePath').val(filePath);
    $('#formDownloadReport').submit();

  }

</script>
