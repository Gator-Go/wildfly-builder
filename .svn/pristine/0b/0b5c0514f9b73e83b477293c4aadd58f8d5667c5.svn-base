<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="ISO-8859-1" %>
<%
String httpRoot = System.getProperty("com.pojomax.sync.app.http-root");
String alertUser = System.getProperty("com.pojomax.sync.app.alert-user");
String alertPassword = System.getProperty("com.pojomax.sync.app.alert-password");
%>


<script>
var page = 1;
var timeoutID = 0;
</script>


<div id="alertsTablePage">

<div id='MyPage' class='pojo-alerts-header'>Alerts Page = 1</div>

<button class='btnPrevious' id="prev" type="button" onclick='getAlertPage(--page);'>Prev</button>
&nbsp;&nbsp;&nbsp;
<button class='btnNext' id="next" type="button" onclick='getAlertPage(++page);'>Next</button>


<div id="alertsBody" class='pojo-alerts-body'>

<table class="pojo_tablestyle">
<thead>
<tr>
  <th valign='top' width='5%'>Action</th>
  <th valign='top' width='5%'>Type</th>
  <th valign='top' width='5%'>ID</th>
  <th valign='top' width='70%'>Message</th>
  <th valign='top' width='15%'>Date</th>
</tr>
</thead>
<tbody id="alerts"></tbody>
</table>
</div>
</div>




<div id="alertsViewPage" style="display: none;">

<div class='pojo-alerts-header'>Alert View</div>

<button class='btnBack' type="button" onclick='showAlerts();'>Back</button>

<div class='pojo-alerts-body'>

<table class="pojo_tablestyle">
<thead>
<tr>
  <th width="10%"></th>
  <th width="23%"></th>
  <th width="10%"></th>
  <th width="23%"></th>
  <th width="10%"></th>
  <th width="23%"></th>
</tr>
</thead>
<tbody id="viewAlert"></tbody>
</table>
</div>
</div>




<script>

getAlerts();

function getAlerts() {
  var alertURL = "<%= httpRoot %>/xxxxxws/rest/xxxxxAlerts";
  $.ajax({
    type: 'GET',
    url: alertURL,
    dataType: "json",
    username: "<%= alertUser %>",
    password: "<%= alertPassword %>",
    success: function(data) {
      if (data){
        var alertData = '';
        $.each(data, function(i, item) {
          alertData = alertData +
            '<tr>' +
            '<td><a onclick=\'getAlertView("' + item.id + '");\'><img border="0" src="resources/gfx/view.gif" alt="View" />View</a></td>' +
            '<td><img border="0" src="' + getIconSrc(item.xxxxxAlertType) + '" alt="Level" />' + item.xxxxxAlertType + '</td>' +
            '<td>' + item.deviceId + '-' + item.xxxxxAlertId + '</td>' +
            '<td>' + formatColumn(item.xxxxxAlertSource, item.xxxxxAlertMessage, 150) + '</td>' +
            '<td>' + item.occurredAt + '</td>' +
            '</tr>';
        });
        
        $('#alerts').html(alertData);
      } else {
        $('#alerts').html('<p>No results returned.</p>');
      }
    }
  }).always(function () {
      timeoutID = window.setTimeout(getAlerts, 3000);//3 seconds
  });
}


function getAlertView(id) {

  window.clearTimeout(timeoutID);
  $("#alertsTablePage").hide();
  $("#alertsViewPage").show();

  var alertURL = "<%= httpRoot %>/xxxxxws/rest/xxxxxAlerts/" + id;
  $.ajax({
    type: 'GET',
    url: alertURL,
    dataType: "json",
    username: "<%= alertUser %>",
    password: "<%= alertPassword %>",
    success: function(data) {
      if (data){
        var alertData =
          '<tr>' +
            '<td style="text-align: right;"><span class="pojo-fronttext">Id:</span></td>' +
            '<td>' + data.id + '</td>' +
            '<td style="text-align: right;"><span class="pojo-fronttext">Device Id:</span></td>' +
            '<td>' + data.deviceId + '</td>' +
            '<td style="text-align: right;"><span class="pojo-fronttext">DeviceAlert Id:</span></td>' +
            '<td>' + data.xxxxxAlertId + '</td>' +
          '</tr>' +
          '<tr>' +
            '<td style="text-align: right;"><span class="pojo-fronttext">Alert Type:</span></td>' +
            '<td>' + data.xxxxxAlertType + '</td>' +
            '<td style="text-align: right;"><span class="pojo-fronttext">Alert Source:</span></td>' +
            '<td>' + data.xxxxxAlertSource + '</td>' +
            '<td style="text-align: right;"><span class="pojo-fronttext">Occurred At:</span></td>' +
            '<td>' + data.occurredAt + '</td>' +
          '</tr>' +
          '<tr>' +
            '<td style="text-align: right;"><span class="pojo-fronttext">Alert Message:</span></td>' +
            '<td colspan=5 >' + data.xxxxxAlertMessage + '</td>' +
          '</tr>';

        
        $('#viewAlert').html(alertData);
      } else {
        $('#viewAlert').html('<p>No results returned.</p>');
      }
    }
  });
}


function showAlerts() {

  $("#alertsTablePage").show();
  $("#alertsViewPage").hide();

  if (page == 0)
    page++;

  document.getElementById("MyPage").innerHTML = "Alerts Page = " + page;

  if (page == 1) {
    getAlerts();
  } else {
    getPage();
  }
}


function getAlertPage(inPage) {

  if (page == 0)
    page++;

  document.getElementById("MyPage").innerHTML = "Alerts Page = " + page;

  if (page == 1) {
    getAlerts();
  } else {
    window.clearTimeout(timeoutID);
    getPage();
  }
}

function getPage() {
  var alertURL = "<%= httpRoot %>/xxxxxws/rest/xxxxxAlertPage/page/" + page;
  $.ajax({
    type: 'GET',
    url: alertURL,
    dataType: "json",
    success: function(data) {
      if (data){
        var alertData = '';
        $.each(data, function(i, item) {
          alertData = alertData +
            '<tr>' +
            '<td><a onclick=\'getAlertView("' + item.id + '");\'><img border="0" src="resources/gfx/view.gif" alt="View" />View</a></td>' +
            '<td><img border="0" src="' + getIconSrc(item.alertType) + '" alt="Level" />' + item.alertType + '</td>' +
            '<td>' + item.deviceId + '-' + item.alertId + '</td>' +
            '<td>' + formatColumn(item.alertSource, item.alertMessage, 150) + '</td>' +
            '<td>' + item.occurredAt + '</td>' +
            '</tr>';
        });
        
        $('#alerts').html(alertData);
      } else {
        $('#alerts').html('<p>No results returned.</p>');
      }
    }
  });
}



function formatColumn(source, message, cch)
{
    var remain = cch;
    var result = "";
    var t1 = source;
    var t2 = message;
        
    // if only message...make it main text
    if (!t1){
        t1 = t2;
        t2 = null;
    }
        
    if (t1 != null){
       
        if (t1.length > remain){
            result += t1.substring(0, remain);
            result += " ...";
            remain = 0;
        }
        else{
            result += t1;
            remain -= t1.length;
        }   
    }
        
    if (t2 != null && remain > 0){
        result = "<span class='pojo-fronttext'>" + result + "</span>";
        result += " - ";
        if (t2.length > remain){
            result += t2.substring(0, remain);
            result += " ...";
        }
        else{
            result += t2;
        }
    }

    if (result.length <= 0){
        result = "&nbsp;";
    }

    var wrap = "<div style='overflow:hidden; white-space:nowrap'>" + result + "</div>";

    return wrap;
}

function getIconSrc(type) {
    var blank = "resources/gfx/icon_blank_16.png";

    if (type){
        type = type.toLowerCase();
    }

    var map = new Array;
    map['fatal'] = "resources/gfx/icon_alert_fatal_16.png";
    map['error'] = "resources/gfx/icon_alert_error_16.png";
    map['warn'] = "resources/gfx/icon_alert_warn_16.png";
    map['info'] = "resources/gfx/icon_alert_info_16.png";
    map['debug'] = "resources/gfx/icon_alert_debug_16.png";
    map['config'] = "resources/gfx/icon_alert_config_16.png";
    map['import'] = "resources/gfx/icon_alert_import_16.png";
    map['web'] = "resources/gfx/icon_alert_web_16.png";
    map['event'] = "resources/gfx/icon_alert_event_16.png";
    map['sync'] = "resources/gfx/icon_alert_sync_16.gif";

    if (map[type]){
        return map[type];
    }
    return blank;
}
</script>

