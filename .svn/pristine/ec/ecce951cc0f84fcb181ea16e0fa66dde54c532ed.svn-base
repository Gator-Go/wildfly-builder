# --- Configuration --------------------------------
GROOVY_SCRIPT="./updateAppsList.groovy"
XML_FILE="APP_APPS.xml"
COMMIT_MSG="Auto-update (via updateAppsList.groovy)"
# -------------------------------------------------

echo "START"
OUTPUT=$(groovy "$GROOVY_SCRIPT" 2>&1)
echo "$OUTPUT"

if echo "$OUTPUT" | grep -Fq "APP_APPS.xml updated"; then
    echo ">>> APP_APPS.xml was updated – committing to SVN"

    # Safely get the one PNG file
    shopt -s nullglob  # Make globs expand to nothing if no match (optional safety)
    PNG_FILES=(*.png)
    shopt -u nullglob

    if [[ ${#PNG_FILES[@]} -ne 1 ]]; then
        echo "Error: Expected exactly one .png file, found ${#PNG_FILES[@]}" >&2
        echo "Found: ${PNG_FILES[*]}" >&2
        exit 1
    fi

    TARGET_DIR=~/Wildfly/WildflyBuilder
    GFX_DIR="$TARGET_DIR/template/xxxxx-war/src/main/webapp/resources/gfx"
    PNG_FILE="${PNG_FILES[0]}"

    cp "$XML_FILE" "$TARGET_DIR/"
    cp "$PNG_FILE" "$GFX_DIR/"

    # --- Go to repo and stage + commit ---
    cd "$TARGET_DIR"

    # add PNG if new
    svn add "$GFX_DIR/$PNG_FILE" 2>/dev/null || true  # Ignore if already added

    svn commit -m "$COMMIT_MSG" --username ron --password svngator
    cd ~/Wildfly/WildflySocial
else
    echo ">>> APP_APPS.xml up-to-date – nothing to commit"
fi