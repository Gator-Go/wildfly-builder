package ppp.ppp.ppp.report;

import ppp.ppp.ppp.report.Constants;
import ppp.ppp.ppp.report.BaseException;
import ppp.ppp.ppp.report.StringUtils;

import java.io.ByteArrayInputStream;
import java.io.IOException;
import java.io.InputStream;
import java.io.OutputStream;
import java.util.Collection;
import java.util.LinkedHashMap;
import java.util.Map;
import java.util.TreeMap;
import java.util.zip.ZipEntry;
import java.util.zip.ZipInputStream;
import java.sql.Connection;
import org.apache.commons.io.FilenameUtils;
import org.apache.commons.io.IOUtils;

import java.util.logging.Logger;
import jakarta.inject.Inject;


public abstract class BaseReport {

    /** Holds the logging component for this class. */
//    @Inject
//    public static Logger logger;

    /** Constant defining the name of the parameter used to defined sorting options. */
    public static final String SORT_OPTION_PARAMETER = "ORDER_BY";
    /** Holds the parameters for the report. */
    protected Map<String, ReportParameter> parameters;
    /** Holds the fields for the report. */
    protected Map<String, ReportField> fields;
    /** Holds the valid formats for the report. */
    protected Map<String, ReportFormat> formats;
    /** Holds the valid data types for the report parameters. */
    protected Collection<String> paramDataTypes;
    /** Holds the references to any subreports for this report. */
    protected Map<String, BaseReport> subreports;

    /**
     * Static factory method to create a new {@link BaseReport} instance for the
     * mime type and {@link InputStream} passed in.
     * @param mimeType the mime type for the report template file contained in
     * the {@link InputStream}
     * @param reportStream an {@link InputStream} containing the contents of the
     * report template
     * @return BaseReport containing the new instance
     * @throws IllegalArgumentException if any of the arguments passed in are
     * invalid
     * @throws BaseException if the new instance cannot be created
     */
    public static BaseReport newInstance(String mimeType, InputStream reportStream) throws IllegalArgumentException, BaseException {


        System.out.println("entering newInstance - mimeType = " + mimeType);
        if (reportStream == null) {
            throw new IllegalArgumentException("A valid report must be specified.");
        }

        BaseReport report = null;
        ZipInputStream zipStream = null;
        Map<String, BaseReport> subreports = new TreeMap<String, BaseReport>();
        try {

            if ((StringUtils.isNotBlank(mimeType)) && (mimeType.equalsIgnoreCase(Constants.MIME_TYPE_ZIP_EXTENSION))) {
                System.out.println("report is a zip file which must contain subreports");
                zipStream = new ZipInputStream(reportStream);
                ZipEntry zipEntry = zipStream.getNextEntry();
                System.out.println("looping through all file in the zip archive");
                while (zipEntry != null) {
                    if (zipEntry.isDirectory()) {
                        // skip directories
                    } else {
                        // copy the zip stream to make sure the original stream is not altered
                        byte[] buffer = IOUtils.toByteArray(zipStream);
                        
                        System.out.println("parsing the report");
                        BaseReport tempReport =  new JasperReport(new ByteArrayInputStream(buffer));
                        tempReport.init();
                        // if there are subreports for this report, then assume it is the main report file
                        if (tempReport.hasSubreports()) {
                            System.out.println(tempReport.getName() + " is the main report for the archive");
                            report = tempReport;
                        } else {
                            System.out.println(tempReport.getName() + " is a suberport");
                            String filename = FilenameUtils.removeExtension(zipEntry.getName());
                            subreports.put(filename, tempReport);
                        }
                    }
                    // move to the next entry in the zip file
                    zipStream.closeEntry();
                    zipEntry = zipStream.getNextEntry();
                }

                // make sure we've identified the main report file
                if (report == null) {
                    throw new BaseException("The zip file must include a primary report " +
                            "file (i.e. one containing subreports).");
                }

                System.out.println("attaching the subreports to the main report file");
                for (String subreportName : subreports.keySet()) {
                    report.addSubreport(subreportName, subreports.get(subreportName));
                }

            } else {

                // we currently only support Jasper reports so we can assume the file is of such type
                System.out.println("creating a new jasper report");
                report = new JasperReport(reportStream);
                report.init();
            }

            System.out.println("making sure all the necessary subreports are present");
            subreports = report.getSubreports();
            if (subreports != null) {
                for (String subreportName : subreports.keySet()) {
                    if (subreports.get(subreportName) == null) {
                        throw new BaseException("The report file for subreport [" + subreportName +
                                "] was not found.  It needs to be included in a zip file with the main report.");
                    }
                }
            }

        } catch (IOException ex) {
            throw new BaseException(ex);
        } finally {
            if (zipStream != null) {
                try {
                    zipStream.close();
                } catch (Exception ignore) {
                }
            }
            System.out.println("exiting newInstance");
        }

        return report;
    }

    /**
     * Static factory method to create a new {@link BaseReport} instance for the
     * mime type and byte array passed in.
     * @param mimeType the mime type for the report template file contained in
     * the {@link InputStream}
     * @param reportBytes a byte array containing the contents of the
     * report template
     * @return BaseReport containing the new instance
     * @throws IllegalArgumentException if any of the arguments passed in are
     * invalid
     * @throws BaseException if the new instance cannot be created
     */
    public static BaseReport newInstance(String mimeType, byte[] reportBytes) throws IllegalArgumentException, BaseException {

        ByteArrayInputStream bais = new ByteArrayInputStream(reportBytes);
        return newInstance(mimeType, bais);
    }

    /**
     * Static factory method to create a new {@link BaseReport} instance for the
     * {@link InputStream} passed in.
     * @param reportStream an {@link InputStream} containing the contents of the
     * report template
     * @return BaseReport containing the new instance
     * @throws IllegalArgumentException if any of the arguments passed in are
     * invalid
     * @throws BaseException if the new instance cannot be created
     */
    public static BaseReport newInstance(InputStream reportStream) throws IllegalArgumentException, BaseException {
        return newInstance(null, reportStream);
    }

    /**
     * Returns the name of the report
     * @return String containing the name of the report
     * @throws BaseException if the name of the report cannot be determined
     */
    abstract public String getName() throws BaseException;

    /**
     * Returns the type of the report
     * @return ReportTypeEnum the type of the report
     */
    abstract public ReportTypeEnum getType();

    /**
     * Returns a boolean indicating whether or not this {@link BaseReport}
     * supports specifying a sort option
     * @return boolean indicating whether or not this {@link BaseReport}
     * supports specifying a sort option
     */
    public boolean isSortAvailable() {
        return ((this.parameters != null) && (this.parameters.containsKey(SORT_OPTION_PARAMETER)));
    }

    /**
     * Returns a {@link Map} containing the valid formats for this report.
     * @return Map containing the valid formats for this report
     */
    abstract public Map<String, ReportFormat> getFormats();

    /**
     * Returns a {@link Collection} containing the valid parameter data types
     * supported for this report.
     * @return Collection containing the valid parameter data types supported 
     * for this report
     */
    abstract public Collection<String> getParamDataTypes();

    /**
     * Returns a {@link Map} containing the parameters available for this report.
     * @return Map containing the parameters available for this report
     * @throws BaseException if the report parameters cannot be determined
     */
    public Map<String, ReportParameter> getParameters() throws BaseException {
	if (this.parameters == null) {
            this.parameters = new LinkedHashMap<>();  // or new HashMap<>()
	}
        return this.parameters;
    }

    /**
     * Adds a {@link ReportParameter} to the report.
     * @param paramName the name of the parameter
     * @param param the object containing the details about the parameter
     * @throws IllegalArgumentException if any of the arguments passed in are
     * invalid
     * @throws BaseException if the parameter cannot be added successfully
     */
    public void addParameter(String paramName, ReportParameter param) throws IllegalArgumentException, BaseException {

        if (StringUtils.isBlank(paramName)) {
            throw new IllegalArgumentException("A valid parameter name must be specified.");
        }
        if (param == null) {
            throw new IllegalArgumentException("A valid parameter must be specified.");
        }
        if (this.parameters == null) {
            this.parameters = new LinkedHashMap<String, ReportParameter>();
        }

        // make sure the data type is valid
        if (!this.isValidParamDataType(param.getDataType())) {
            throw new BaseException(param.getDataType() +
                " is an unsupported parameter type.");
        }

        // make sure the parameter name doesn't contain any special characters
        String temp = StringUtils.javaScriptEscape(paramName);
        if (!paramName.equals(temp)) {
            throw new BaseException("The parameter name [" + paramName + "] contains invalid characters.");
        }

        // make sure the parameter description doesn't contain any special characters
        String desc = param.getDescription();
        temp = StringUtils.javaScriptEscape(desc);
        if ((desc != null) && (!desc.equals(temp))) {
            throw new BaseException("The description for parameter  [" + paramName + "] contains invalid characters.");
        }

        this.parameters.put(paramName, param);
    }

    /**
     * Returns a {@link Map} containing the fields available for this report.
     * @return Map containing the fields available for this report
     * @throws BaseException if the report fields cannot be determined
     */
    public Map<String, ReportField> getFields() throws BaseException {
        return this.fields;
    }

    /**
     * Adds a placeholder for a subreport to this report by reserving the
     * subreport name
     * @param subreportName the name of the subreport
     * @throws IllegalArgumentException if any of the arguments passed in are
     * invalid
     */
    public void addSubreport(String subreportName) throws IllegalArgumentException {
        this.addSubreport(subreportName, null);
    }

    /**
     * Adds a subreport to the report
     * @param subreportName the name of the subreport
     * @param subreport a reference to the {@link BaseReport} to be added as a
     * subreport
     * @throws IllegalArgumentException if any of the arguments passed in are
     * invalid
     */
    public void addSubreport(String subreportName, BaseReport subreport) throws IllegalArgumentException {

        if (StringUtils.isBlank(subreportName)) {
            throw new IllegalArgumentException("A valid subreport name must be specified.");
        }

        if ((this.subreports == null) || (this.subreports.isEmpty())) {
            this.subreports = new TreeMap<String, BaseReport>();
        }

        this.subreports.put(subreportName, subreport);
    }

    /**
     * Returns a {@link Map} with the subreports for this report
     * @return Map containing the subreports for this report
     */
    public Map<String, BaseReport> getSubreports() {
        return this.subreports;
    }

    /**
     * Returns a boolean indicating whether or not this report has subreports
     * @return boolean true if the report has subreports and false otherwise
     */
    public boolean hasSubreports() {
        return ((this.subreports != null) && (!this.subreports.isEmpty()));
    }

    /**
     * Returns the {@link ReportFormat} corresponding to the mime type passed in
     * @param mimeType the mime type of the desired {@link ReportFormat}
     * @return ReportFormat that matches the mime type passed in
     */
    public ReportFormat getFormat(String mimeType) {

        ReportFormat format = null;
        Map<String, ReportFormat> formats = this.getFormats();
        if ((formats != null) && (formats.size() > 0)) {
            format = formats.get(mimeType);
        }
        return format;

    }

    /**
     * Returns the {@link ReportFormat} corresponding to the mime type passed in.
     * If there is no match for the mime type, the {@link ReportFormat} for the
     * default mime type will be returned.
     * @param mimeType the mime type of the desired {@link ReportFormat}
     * @param defaultMimeType the mime type to be used if the desired mime type
     * is not found
     * @return ReportFormat that matches the mime type passed in
     */
    public ReportFormat getFormat(String mimeType, String defaultMimeType) {

        ReportFormat format = this.getFormat(mimeType);
        if (format == null) {
            format = this.getFormat(defaultMimeType);
        }
        return format;
    }

    /**
     * Returns a boolean indicating whether or not the parameter data type is
     * valid for this report.
     * @param className the class name for the data type to check
     * @return boolean true if the parameter data type is valid for this report
     * and false otherwise
     */
    public boolean isValidParamDataType(String className) {
        Collection<String> types = this.getParamDataTypes();
        return ((types != null) && (types.contains(className)));
    }

    /**
     * Abstract method used to initialize the report.
     * @throws BaseException if the report could not be properly initialized
     */
    abstract public void init() throws BaseException;

    /**
     * Abstract method used to compile the report.
     * @throws BaseException if the report could not be properly compiled
     */
    abstract public void compile() throws BaseException;

    /**
     * This method renders the report to the desired {@link ReportFormat} using
     * the specified report parameters, 
     * @param format the desired output format for the report
     * @param params the parameter values to pass to the report
     * @param stream the {@link OutputStream} to send the rendered report to
     * @throws BaseException if the report cannot be rendered successfully
     */
    public void render(ReportFormat format, Map params, OutputStream stream, Connection conn) throws BaseException {
        if (params == null) params = new HashMap<>();
        if (conn == null) throw new IllegalArgumentException("Connection required");
        try {
            renderInternal(format, params, stream, conn);
        } catch (Exception ex) {
            throw new BaseException(ex);
        }
    }

    protected abstract void renderInternal(ReportFormat format, Map params,
                                       OutputStream stream, Connection conn) throws BaseException {

        try {
            // check for the required parameters
            if (stream == null) {
                throw new IllegalArgumentException("A valid output stream must be specified.");
            }

            // if no format is specified, default to html
            ReportFormat.Type type = null;
            if ((format == null) || (format.getType() == null)) {
                type = ReportFormat.Type.MIME_TYPE_HTML;
            } else {
                type = format.getType();
            }

            // render the appropriate report
            if (type.equals(ReportFormat.Type.MIME_TYPE_CSV)) {
                this.renderAsCsv(params, stream);
            } else if (type.equals(ReportFormat.Type.MIME_TYPE_HTML)) {
                this.renderAsHtml(params, stream);
            } else if (type.equals(ReportFormat.Type.MIME_TYPE_EXCEL)) {
                this.renderAsExcel(params, stream);
            } else if (type.equals(ReportFormat.Type.MIME_TYPE_DOCX)) {
                this.renderAsWord(params, stream);
            } else if (type.equals(ReportFormat.Type.MIME_TYPE_PDF)) {
                this.renderAsPdf(params, stream);
            } else if (type.equals(ReportFormat.Type.MIME_TYPE_RTF)) {
                this.renderAsRtf(params, stream);
            } else if (type.equals(ReportFormat.Type.MIME_TYPE_PLAINTEXT)) {
                this.renderAsTxt(params, stream);
            }
                
        } catch (Exception ex) {
            throw new BaseException(ex);
        }
    }

    /**
     * Abstract method to render the report as a CSV file.
     * @param params the parameter values to pass to the report
     * @param stream the {@link OutputStream} to send the rendered report to
     * @throws BaseException if the report cannot be rendered successfully
     */
    abstract protected void renderAsCsv(Map params, OutputStream stream) throws BaseException;

    /**
     * Abstract method to render the report as an HTML file.
     * @param params the parameter values to pass to the report
     * @param stream the {@link OutputStream} to send the rendered report to
     * @throws BaseException if the report cannot be rendered successfully
     */
    abstract protected void renderAsHtml(Map params, OutputStream stream) throws BaseException;

    /**
     * Abstract method to render the report as a Microsoft Excel file.
     * @param params the parameter values to pass to the report
     * @param stream the {@link OutputStream} to send the rendered report to
     * @throws BaseException if the report cannot be rendered successfully
     */
    abstract protected void renderAsExcel(Map params, OutputStream stream) throws BaseException;

    /**
     * Abstract method to render the report as a Microsoft Word file.
     * @param params the parameter values to pass to the report
     * @param stream the {@link OutputStream} to send the rendered report to
     * @throws BaseException if the report cannot be rendered successfully
     */
    abstract protected void renderAsWord(Map params, OutputStream stream) throws BaseException;

    /**
     * Abstract method to render the report as a PDF file.
     * @param params the parameter values to pass to the report
     * @param stream the {@link OutputStream} to send the rendered report to
     * @throws BaseException if the report cannot be rendered successfully
     */
    abstract protected void renderAsPdf(Map params, OutputStream stream) throws BaseException;

    /**
     * Abstract method to render the report as an RTF file.
     * @param params the parameter values to pass to the report
     * @param stream the {@link OutputStream} to send the rendered report to
     * @throws BaseException if the report cannot be rendered successfully
     */
    abstract protected void renderAsRtf(Map params, OutputStream stream) throws BaseException;

    /**
     * Abstract method to render the report as a TXT file.
     * @param params the parameter values to pass to the report
     * @param stream the {@link OutputStream} to send the rendered report to
     * @throws BaseException if the report cannot be rendered successfully
     */
    abstract protected void renderAsTxt(Map params, OutputStream stream) throws BaseException;

}
