package ppp.ppp.ppp.report;

import ppp.ppp.ppp.report.BaseException;

import java.io.InputStream;
import java.io.OutputStream;
import java.io.Serializable;
import java.io.OutputStreamWriter;
import java.nio.charset.StandardCharsets;
import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Timestamp;
import java.util.ArrayList;
import java.util.Collection;
import java.util.Date;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.TreeMap;
import java.math.BigDecimal;
import java.util.LinkedHashMap;

import net.sf.jasperreports.engine.JRField;
import net.sf.jasperreports.engine.JRParameter;
import net.sf.jasperreports.engine.JasperCompileManager;
import net.sf.jasperreports.engine.JasperFillManager;
import net.sf.jasperreports.engine.JasperPrint;
import net.sf.jasperreports.engine.design.JasperDesign;
import net.sf.jasperreports.engine.xml.JRXmlLoader;
import net.sf.jasperreports.engine.export.JRCsvExporter;
import net.sf.jasperreports.engine.export.HtmlExporter;
import net.sf.jasperreports.engine.export.JRPdfExporter;
import net.sf.jasperreports.engine.export.JRRtfExporter;
import net.sf.jasperreports.engine.export.JRTextExporter;
import net.sf.jasperreports.engine.export.ooxml.JRXlsxExporter;
import net.sf.jasperreports.engine.export.ooxml.JRDocxExporter;
import net.sf.jasperreports.export.SimpleExporterInput;
import net.sf.jasperreports.export.SimpleOutputStreamExporterOutput;
import net.sf.jasperreports.export.SimpleTextReportConfiguration;
import net.sf.jasperreports.export.SimpleHtmlExporterOutput;
import net.sf.jasperreports.export.SimpleWriterExporterOutput;

public class JasperReport extends BaseReport implements Serializable {

    private static final long serialVersionUID = 4423995085270068263L;

    private InputStream fileStream = null;
    private JasperDesign design = null;
    private net.sf.jasperreports.engine.JasperReport runtime = null;

    protected JasperReport() {
    }

    protected JasperReport(InputStream fileStream) {
        this.fileStream = fileStream;
    }

    protected JasperDesign getDesign() {
        return this.design;
    }

    protected net.sf.jasperreports.engine.JasperReport getRuntime() {
        return this.runtime;
    }

    @Override
    public void init() throws BaseException {
        System.out.println("initializing report");
        try {
            this.design = null;
            this.runtime = null;
            if (this.parameters != null) {
                this.parameters.clear();
                this.parameters = null;
            }

            System.out.println("loading the report design");
            this.design = JRXmlLoader.load(this.fileStream);

            System.out.println("parsing parameters for report [" + this.getName() + "]");
            List<JRParameter> jrParams = this.design.getParametersList();
            List<JRParameter> optionalParams = new ArrayList<>();
            String paramName;
            if (jrParams != null && !jrParams.isEmpty()) {
                for (JRParameter jrParam : jrParams) {
                    paramName = jrParam.getName();
                    if (jrParam.isSystemDefined()) {
                        //.:

                        // skip system-defined parameters
                    } else {
                        if (jrParam.isForPrompting()) {
                            ReportParameter param = new ReportParameter();
                            param.setName(paramName);
                            param.setDescription(jrParam.getDescription());
                            param.setDataType(jrParam.getValueClassName());
                            param.setRequired(true);
                            this.addParameter(paramName, param);
                        } else if (jrParam.getValueClassName().equalsIgnoreCase(net.sf.jasperreports.engine.JasperReport.class.getCanonicalName())) {
                            this.addSubreport(paramName);
                        }
                        if (paramName.endsWith("_CLAUSE")) {
                            optionalParams.add(jrParam);
                        }
                    }
                }
                for (JRParameter optionalParam : optionalParams) {
                    paramName = optionalParam.getName().replace("_CLAUSE", "");
                    if (this.parameters.containsKey(paramName)) {
                        this.parameters.get(paramName).setRequired(false);
                    }
                }
            }

            System.out.println("parsing fields for report [" + this.getName() + "]");
            List<JRField> jrFields = this.design.getFieldsList();
            if (jrFields != null && !jrFields.isEmpty()) {
                this.fields = new TreeMap<>();
                for (JRField jrField : jrFields) {
                    ReportField field = new ReportField();
                    field.setName(jrField.getName());
                    field.setDescription(jrField.getDescription());
                    field.setType(jrField.getValueClassName());
                    this.fields.put(field.getName(), field);
                }
            }

        } catch (Exception ex) {
            throw new BaseException(ex);
        }
    }

    @Override
    public void compile() throws BaseException {
        if (this.design == null) {
            throw new BaseException("This report has not been initialized.");
        }

        if (this.runtime != null) {
            return;
        }

        try {
            System.out.println("compiling report " + this.getName());
            this.runtime = JasperCompileManager.compileReport(design);
            System.out.println("Finished compiling report " + this.getName());
        } catch (Exception ex) {
            System.out.println("IN Exception: " + ex.getMessage());
            throw new BaseException(ex);
        }
    }

    @Override
    public String getName() throws BaseException {
        if (this.design == null) {
            throw new BaseException("This report has not been initialized.");
        }
        return this.design.getName();
    }

    @Override
    public ReportTypeEnum getType() {
        return ReportTypeEnum.JASPER;
    }

    @Override
    public Map<String, ReportFormat> getFormats() {
        if (this.formats == null || this.formats.isEmpty()) {
            this.formats = getValidFormats();
        }
        return this.formats;
    }

    public static Map<String, ReportFormat> getValidFormats() {
        Map<String, ReportFormat> formats = new LinkedHashMap<>();
        formats.put(ReportFormat.Type.MIME_TYPE_CSV.getValue(), new ReportFormat(ReportFormat.Type.MIME_TYPE_CSV));
        formats.put(ReportFormat.Type.MIME_TYPE_HTML.getValue(), new ReportFormat(ReportFormat.Type.MIME_TYPE_HTML));
        formats.put(ReportFormat.Type.MIME_TYPE_EXCEL.getValue(), new ReportFormat(ReportFormat.Type.MIME_TYPE_EXCEL));
        formats.put(ReportFormat.Type.MIME_TYPE_DOCX.getValue(), new ReportFormat(ReportFormat.Type.MIME_TYPE_DOCX));
        formats.put(ReportFormat.Type.MIME_TYPE_PDF.getValue(), new ReportFormat(ReportFormat.Type.MIME_TYPE_PDF));
        formats.put(ReportFormat.Type.MIME_TYPE_RTF.getValue(), new ReportFormat(ReportFormat.Type.MIME_TYPE_RTF));
        formats.put(ReportFormat.Type.MIME_TYPE_PLAINTEXT.getValue(), new ReportFormat(ReportFormat.Type.MIME_TYPE_PLAINTEXT));
        return formats;
    }

    @Override
    public Collection<String> getParamDataTypes() {
        if (this.paramDataTypes == null || this.paramDataTypes.isEmpty()) {
            this.paramDataTypes = getValidParamDataTypes();
        }
        return this.paramDataTypes;
    }

    public static Collection<String> getValidParamDataTypes() {
        Collection<String> types = new ArrayList<>();
        types.add(Boolean.class.getCanonicalName());
        types.add(Date.class.getCanonicalName());
        types.add(Timestamp.class.getCanonicalName());
        types.add(Double.class.getCanonicalName());
        types.add(Float.class.getCanonicalName());
        types.add(Byte.class.getCanonicalName());
        types.add(Integer.class.getCanonicalName());
        types.add(Short.class.getCanonicalName());
        types.add(Long.class.getCanonicalName());
        types.add(String.class.getCanonicalName());
        types.add(BigDecimal.class.getCanonicalName());
        return types;
    }

    @Override
    protected void renderAsCsv(Map params, OutputStream stream) throws BaseException {
        JRCsvExporter exporter = new JRCsvExporter();
        this.renderReport(params, stream, exporter);
    }

    @Override
    protected void renderAsHtml(Map params, OutputStream stream) throws BaseException {
        HtmlExporter exporter = new HtmlExporter();
        this.renderReport(params, stream, exporter);
    }

    @Override
    protected void renderAsExcel(Map params, OutputStream stream) throws BaseException {
        JRXlsxExporter exporter = new JRXlsxExporter();
        this.renderReport(params, stream, exporter);
    }

    @Override
    protected void renderAsWord(Map params, OutputStream stream) throws BaseException {
        JRDocxExporter exporter = new JRDocxExporter();
        this.renderReport(params, stream, exporter);
    }

    @Override
    protected void renderAsPdf(Map params, OutputStream stream) throws BaseException {
        JRPdfExporter exporter = new JRPdfExporter();
        this.renderReport(params, stream, exporter);
    }

    @Override
    protected void renderAsRtf(Map params, OutputStream stream) throws BaseException {
        JRRtfExporter exporter = new JRRtfExporter();
        this.renderReport(params, stream, exporter);
    }

    @Override
    protected void renderAsTxt(Map params, OutputStream stream) throws BaseException {
        try {
            JRTextExporter exporter = new JRTextExporter();
            SimpleTextReportConfiguration config = new SimpleTextReportConfiguration();
            config.setCharWidth(8f);
            config.setCharHeight(8f);
            exporter.setConfiguration(config);
            this.renderReport(params, stream, exporter);
        } catch (Exception ex) {
            throw new BaseException(ex);
        }
    }

    private void renderReport(Map params, OutputStream stream, Object exporter, Connection conn) throws BaseException {
        System.out.println("entering renderReport");

        if (conn == null) {
            System.out.println("DB Connection is NULL");
            return;
        }

        try {
          System.out.println("compiling the report design");
          this.compile();
          if (this.runtime == null) {
              throw new BaseException("This report was not successfully compiled.");
          }

          if (this.hasSubreports()) {
            System.out.println("linking the " + this.subreports.size() + " subreports");
            if (params == null) {
                params = new HashMap();
            }
            for (String subreportName : this.subreports.keySet()) {
                System.out.println("compiling and linking subreport " + subreportName);
                JasperReport tempReport = (JasperReport) this.subreports.get(subreportName);
                tempReport.compile();
                params.put(subreportName, tempReport.getRuntime());
            }
        }

        System.out.println("filling data for report [" + this.getName() + "]");
        JasperPrint print = JasperFillManager.fillReport(this.runtime, params, conn);

        System.out.println("exporting report " + this.getName());
        if (exporter instanceof HtmlExporter) {
            HtmlExporter htmlExporter = (HtmlExporter) exporter;
            htmlExporter.setExporterInput(new SimpleExporterInput(print));
            htmlExporter.setExporterOutput(new SimpleHtmlExporterOutput(stream));
            htmlExporter.exportReport();
        } else if (exporter instanceof JRCsvExporter) {
            JRCsvExporter csvExporter = (JRCsvExporter) exporter;
            csvExporter.setExporterInput(new SimpleExporterInput(print));
            csvExporter.setExporterOutput(new SimpleWriterExporterOutput(new OutputStreamWriter(stream, StandardCharsets.UTF_8)));
            csvExporter.exportReport();
        } else if (exporter instanceof JRPdfExporter) {
            JRPdfExporter pdfExporter = (JRPdfExporter) exporter;
            pdfExporter.setExporterInput(new SimpleExporterInput(print));
            pdfExporter.setExporterOutput(new SimpleOutputStreamExporterOutput(stream));
            pdfExporter.exportReport();
        } else if (exporter instanceof JRXlsxExporter) {
            JRXlsxExporter xlsxExporter = (JRXlsxExporter) exporter;
            xlsxExporter.setExporterInput(new SimpleExporterInput(print));
            xlsxExporter.setExporterOutput(new SimpleOutputStreamExporterOutput(stream));
            xlsxExporter.exportReport();
        } else if (exporter instanceof JRDocxExporter) {
            JRDocxExporter docxExporter = (JRDocxExporter) exporter;
            docxExporter.setExporterInput(new SimpleExporterInput(print));
            docxExporter.setExporterOutput(new SimpleOutputStreamExporterOutput(stream));
            docxExporter.exportReport();
        } else if (exporter instanceof JRRtfExporter) {
            JRRtfExporter rtfExporter = (JRRtfExporter) exporter;
            rtfExporter.setExporterInput(new SimpleExporterInput(print));
            rtfExporter.setExporterOutput(new SimpleWriterExporterOutput(new OutputStreamWriter(stream, StandardCharsets.UTF_8)));
            rtfExporter.exportReport();
        } else if (exporter instanceof JRTextExporter) {
            JRTextExporter textExporter = (JRTextExporter) exporter;
            SimpleTextReportConfiguration config = new SimpleTextReportConfiguration();
            config.setCharWidth(8f);
            config.setCharHeight(8f);
            textExporter.setConfiguration(config);
            textExporter.setExporterInput(new SimpleExporterInput(print));
            textExporter.setExporterOutput(new SimpleWriterExporterOutput(new OutputStreamWriter(stream, StandardCharsets.UTF_8)));
            textExporter.exportReport();
        } else {
            throw new BaseException("Unsupported exporter type: " + exporter.getClass().getName());
        }


    } catch (Exception e) {
        throw new BaseException(e);
    } finally {
        if (conn != null) {
            try { conn.close(); } catch (SQLException ignored) {}
        }
        System.out.println("exiting renderReport");
    }
  }

}
