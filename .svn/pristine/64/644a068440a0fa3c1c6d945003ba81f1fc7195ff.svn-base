<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="ISO-8859-1"%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">

<div class='pojo-section'>
<div class='pojo-section-header'>DDDDD Search Form</div>
<div class='pojo-section-body'>
<div align="left">

    <c:set var="yyyyy" value="${yyyyy}"/>
    <c:set var="yyyyy2" value="${yyyyy2}"/>
    <form id="idYyyyySearch" name="YyyyySearch" action="do" method="POST">

        <p>
            <label style="color: red;width: 100%;text-align: left;">${errorMessage}</label> 
        </p>

        <input type='hidden' id="opYyyyySearch" name='op' value="${opAction}">
        <input type='hidden' name='id' value="0">
        <input type='hidden' name='deviceId' value="0">
        <input type='hidden' name='yyyyyId' value="0">
        <input type='hidden' name='lastUpdate' value="${yyyyy.lastUpdate}">

        <table class="pojo_tablestyle">

            <tr>
               <th width="20%"></th>
               <th width="30%"></th>
               <th width="20%"></th>
               <th width="30%"></th>
            </tr>

___JSP_SEARCH_STRING___
___JSP_SEARCH_ENUM___
___JSP_SEARCH_TAG___
___JSP_SEARCH_CLOB___
___JSP_SEARCH_INTEGER___
___JSP_SEARCH_DOUBLE___
___JSP_SEARCH_BOOLEAN___
___JSP_SEARCH_MONEY___
___JSP_SEARCH_LOC___
___JSP_SEARCH_CURRENT_LOC___
___JSP_SEARCH_DATE___
___JSP_SEARCH_DATE_TIME___
___JSP_SRCH_ONE2MANY_CHILD___
___JSP_SRCH_ONE2MANY_CHILD_ALERT___

          <c:if test="${!empty admin}">
            <tr>
              <td style="text-align: right;"><label for="deleteFlag">Delete Flag:</label></td>
              <c:if test="${yyyyy.deleteFlag.booleanValue() == true}">
                <td><input type="checkbox" id=deleteFlag name="deleteFlag" value="true" checked />
              </c:if>
              <c:if test="${(empty yyyyy.deleteFlag) || (yyyyy.deleteFlag.booleanValue() == false)}">
                <td><input type="checkbox" id=deleteFlag name="deleteFlag" value="true" />
              </c:if>
              </td>
            </tr>
          </c:if>

        </table>
        <p>
            <button class='btnSearch' id="search" type="button" onclick='goYyyyySearch("${opAction}");'>Search</button>
            &nbsp;&nbsp;&nbsp;
            <button class='btnBack' id="back" type="button" onclick='goYyyyySearch("${opBack}");'>Back</button>
        </p>

    </form>

</div>

<script>
  function goYyyyySearch(op)
  {
    $('#opYyyyySearch').val(op);
    $('#idYyyyySearch').submit();
  }

  function goDatePicker(y, fmt)
  {
    $(y).datepicker({dateFormat:fmt});
    $(y).focus();
  }
</script>

</div>
</div>
