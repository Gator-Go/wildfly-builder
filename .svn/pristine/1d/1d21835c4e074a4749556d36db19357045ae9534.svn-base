<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="ISO-8859-1"%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<%
String httpRoot = System.getProperty("com.pojomax.sync.app.http-root");
%>

___LOCS_DEFINITION_LOC___
___LOCS_DEFINITION_CURRENT_LOC___

<div class='pojo-section'>
<div class='pojo-section-header'>DDDDD Delete Form</div>
<div class='pojo-section-body'>
<div align="left">

    <c:set var="yyyyy" value="${yyyyy}"/>
    <form id="idYyyyyDelete" name="regform" action="do" method="POST">

        <input type='hidden' id="opYyyyyDelete" name='op' value="${opAction}">
        <input type='hidden' name='id' value="${yyyyy.id}">

        <c:if test="${yyyyy.deleteFlag}">
            <br><font class="Verdana"><b>Yyyyy Un-Delete Confirmation</b></font>
        </c:if>
        <c:if test="${!yyyyy.deleteFlag}">
            <br><font class="Verdana"><b>Yyyyy Delete Confirmation</b></font>
        </c:if>

        <table class="pojo_tablestyle">

            <tr>
               <th width="10%"></th>
               <th width="23%"></th>
               <th width="10%"></th>
               <th width="23%"></th>
               <th width="10%"></th>
               <th width="23%"></th>
            </tr>

            <tr class="detail" style="display:none;">
              <td style="text-align: right;"><label for="id">Id:</label></td>
              <td>${yyyyy.id}</td>

              <td style="text-align: right;"><label for="deviceId">Device Id:</label></td>
              <td>${yyyyy.deviceId}</td>

              <td style="text-align: right;"><label for="yyyyyId">Yyyyy Id:</label></td>
              <td>${yyyyy.yyyyyId}</td>
            </tr>

            <tr class="detail" style="display:none;">
              <td style="text-align: right;"><label for="lastUpdate">Last Update:</label></td>
              <td>${yyyyy.lastUpdate}</td>

              <td style="text-align: right;"><label for="deleteFlag">Delete Flag:</label></td>
              <td>${yyyyy.deleteFlag}</td>
            </tr>

___JSP_DELETE_STRING___
___JSP_DELETE_ENUM___
___JSP_DELETE_TAG___
___JSP_DELETE_INTEGER___
___JSP_DELETE_LONG___
___JSP_DELETE_DOUBLE___
___JSP_DELETE_BOOLEAN___
___JSP_DELETE_BIG_DECIMAL___
___JSP_DELETE_MONEY___
___JSP_DELETE_DATE___
___JSP_DELETE_DATE_TIME___
___JSP_DELETE_ONE2MANY_CHILD___
___JSP_DELETE_ONE2MANY_CHILD_ALERT___
___JSP_TR_FINALLY_3___

___JSP_DELETE_LOC___
___JSP_DELETE_CURRENT_LOC___
___JSP_DELETE_CLOB___
___JSP_DELETE_CAMERA___
___JSP_DELETE_VIDEO___
___JSP_DELETE_THUMBNAIL___
___JSP_DELETE_POST___
        </table>

___JSP_DELETE_PIC_THUMBNAIL___
___JSP_DELETE_THUMB_VIDEO___
___JSP_DELETE_THUMB_CAMERA___
___JSP_DELETE_THUMB_POST___
___PUSH_LOC___
___PUSH_CURRENT_LOC___

        <p>
            <c:if test="${yyyyy.deleteFlag}">
                <button class='btnDelete' id="add" type="button" onclick='goYyyyyDelete("${opAction}");'>Un-Delete</button>
            </c:if>
            <c:if test="${!yyyyy.deleteFlag}">
                <button class='btnDelete' id="add" type="button" onclick='goYyyyyDelete("${opAction}");'>Delete</button>
            </c:if>
            &nbsp;&nbsp;&nbsp;
            <button class='btnBack' id="back" type="button" onclick='goYyyyyDelete("${opBack}");'>Back</button>
            &nbsp;&nbsp;&nbsp;
            <button class='btnView' id="show" type="button" onclick='goShow();'>Details</button>
        </p>

    </form>

</div>

<script>

  function goShow()
  {
    var detail = $('.detail');
    detail.toggle();
  }

  function goYyyyyDelete(op)
  {
    $('#opYyyyyDelete').val(op);
    $('#idYyyyyDelete').submit();
  }

___GMAP_SCRIPT_LOC___
___GMAP_SCRIPT_CURRENT_LOC___
</script>


</div>
</div>
