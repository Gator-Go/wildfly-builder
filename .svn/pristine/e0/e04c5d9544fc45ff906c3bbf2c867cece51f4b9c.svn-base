   /**
    * The doAdminRptDeleteAction method deletes the AdminReport from delete web page data.
    *
    * @param req A HttpServletRequest object containing the request data.
    * @param resp A HttpServletResponse object containing the response data.
    */
    public void doAdminRptDeleteAction(HttpServletRequest req, HttpServletResponse resp) throws ServletException, IOException {

        Long reportId = new Long(req.getParameter(ConstRpt.ID));

        String result = reportService.deleteReport(reportId);
        if (!result.equals("success"))
        {
            req.setAttribute(ConstRpt.MSG, "Report Delete Error " + result);
            log.warning("result = " + result);
        }
        else
            req.setAttribute(ConstRpt.MSG, "Report Record Deleted Successfully");

        doAdminHome(req, resp);
    }


    public void doRptListList(HttpServletRequest req, HttpServletResponse resp) throws ServletException, IOException {

        req.getSession().setAttribute("rptListSearchCriteria", null);
        req.getSession().setAttribute("rptListSearchCriteria2", null);

        String subOp = req.getParameter("opSub");
        if (subOp == null)
            subOp = "new";

        Long count = reportService.getCountRptListing();
        if (count.intValue() == 0)
        {
            req.setAttribute("pageInfo", "0 Rows - Page  1 of 1");
            req.setAttribute("op", "RptListList");
            return;
        }

        Integer page = new Integer(1);
        String pageStr = (String) req.getSession().getAttribute("rptListPage");
        if (pageStr != null)
           page = new Integer(pageStr);
        int nbrOfPages = count.intValue() / RowsToPage;
        if (count.intValue() % RowsToPage > 0)
           nbrOfPages++;

        if (subOp.equals("nextPage")) {
           page = new Integer(page.intValue() + 1);
           req.getSession().setAttribute("rptListPage", page.toString());
        }
        if (subOp.equals("previousPage")) {
           page = new Integer(page.intValue() - 1);
           req.getSession().setAttribute("rptListPage", page.toString());
        }

        String pageInfo = count.intValue() + " Rows - Page " + page.toString() + " of " + nbrOfPages;
        req.setAttribute("pageInfo", pageInfo);

        if (page.intValue() <  nbrOfPages)
           req.setAttribute("nextFlag", "true");
        if (page.intValue() >  1)
           req.setAttribute("previousFlag", "true");

	int first = 0;
	if (page.intValue() > 1)
            first = (page.intValue() * RowsToPage) - (RowsToPage + 1);

        List<RptList> rptListing = reportService.getRptListPage(first, RowsToPage);

        if (req.isUserInRole("ADMIN"))
            req.setAttribute("admin", "admin");
        req.setAttribute("rptListing", rptListing);
        req.setAttribute("op", "RptListList");

    }

   /**
    * The doDeleteWebservice method calls the RptList delete web page.
    * It loads RptList data to the web page.
    *
    * @param req A HttpServletRequest object containing the req data.
    * @param resp A HttpServletResponse object containing the response data.
    */
    public void doRptListDelete(HttpServletRequest req, HttpServletResponse resp) throws ServletException, IOException {

        Long id = new Long(req.getParameter("id"));
        RptList rptList = reportService.getRptList(id);
        req.setAttribute("rptList", rptList);


        if (req.getSession().getAttribute("rptListSearchCriteria") == null)
            req.setAttribute("opBack", "RptListList");
        else
            req.setAttribute("opBack", "RptListSearchList");



        req.setAttribute("opAction", "RptListDeleteAction");
        req.setAttribute("op", "RptListDelete");
    }

   /**
    * The doDeleteWebserviceAction method deletes the RptList from delete web page data.
    *
    * @param req A HttpServletRequest object containing the req data.
    * @param resp A HttpServletResponse object containing the response data.
    */
    public void doRptListDeleteAction(HttpServletRequest req, HttpServletResponse resp) throws ServletException, IOException {

        Long id = new Long(req.getParameter("id"));

        String result = reportService.deleteRptList(id);
        if (!result.equals("success"))
        {
            req.setAttribute("msg", "RptList Delete Error: " + result);
            log.warning("delete result = " + result);
        }
        else
            req.setAttribute("msg", "RptList Delete Flag Update Successful");

        doRptListList(req, resp);

    }

}
