   /**
    * The doAdminRptAdd method calls the Admin Rpt import jrxml web page.
    *
    * @param req A HttpServletRequest object containing the request data.
    * @param resp A HttpServletResponse object containing the response data.
    */
    public void doAdminRptAdd(HttpServletRequest req, HttpServletResponse resp) throws ServletException, IOException {

        req.setAttribute(ConstRpt.TITLE, "Import JRXML File");
        req.setAttribute(ConstRpt.OP_ACTION, ConstRpt.OP_ADMIN_RPT_ADD_ACTION);
        req.setAttribute(ConstRpt.OP_BACK, ConstRpt.OP_ADMIN_HOME);
        req.setAttribute(ConstRpt.OP, ConstRpt.OP_ADMIN_RPT_ADD);
    }

   /**
    * The doAdminRptAddAction method imports the JRXML data using file data from the web page.
    *
    * @param req A HttpServletRequest object containing the request data.
    * @param resp A HttpServletResponse object containing the response data.
    */
    public void doAdminRptAddAction(HttpServletRequest req, HttpServletResponse resp) throws ServletException, IOException {

        InputStream inputStream = commonLib.loadFileUpload(req);

        String filePath = (String)req.getAttribute("filePath");
        String mimeType = filePath.split("\\.")[1];
        log.info("*** In doAdminRptAddAction *** filePath = " + filePath + " mimeType = " + mimeType);
        if(filePath == null || filePath.isEmpty()) {
            doAdminRptAdd(req, resp);
            req.setAttribute(ConstRpt.MSG, "File Data Not Loaded");
            return;
        }

        String strFile = System.getProperty("com.pojomax.sync.app.report.dir") + filePath;
        File jrxmlfile = new File(strFile);
        OutputStream outputStream = new FileOutputStream(jrxmlfile);

        try {
          byte[] buffer = new byte[1024];
          int bytesRead;
          while ((bytesRead = inputStream.read(buffer)) != -1) {
            outputStream.write(buffer, 0, bytesRead);
          }
        } catch (IOException e) {
           doAdminRptAdd(req, resp);
           req.setAttribute(ConstRpt.MSG, "Error Creating JRXML File. error = " + e);
           return;
        }
        inputStream.close();
        outputStream.close();

        log.info("filePath = " + filePath);
        Report report = new Report();
        report.setReportFileName(filePath);
        Collection<RptParam> rptParams = new ArrayList<RptParam>();
        Collection<RptSort> rptSorts = new ArrayList<RptSort>();

        try {
          InputStream is = new FileInputStream(strFile);
          BaseReport baseReport = BaseReport.newInstance(mimeType, is);

          log.info("jrxml Name = " + baseReport.getName());
          report.setReportName(baseReport.getName());
          report.setReportDesc(baseReport.getName() + " Description");

          Map<String, ReportParameter> parameters = baseReport.getParameters();
	  if (parameters == null) {
	       parameters = new HashMap<>();  // Safe default
	  }
          for (Map.Entry<String, ReportParameter> entry : parameters.entrySet()) {
              ReportParameter parameter = entry.getValue();
              String paramName = parameter.getName();
              log.info("jrxml Parameter Name = " + paramName);
              if (paramName.startsWith("ORDER_BY")) {
                RptSort rptSort = new RptSort();
                rptSort.setSortReport(report);
rptSort.setSortOption(paramName);
//                String[] parts = paramName.split("-");
//                if ( parts.length == 3)
//                  rptSort.setSortOption(parts[1] + " " + parts[2]);
//                else
//                  rptSort.setSortOption("Invalid Sort Option");
                rptSorts.add(rptSort);
              } else {
                RptParam rptParam = new RptParam();
                rptParam.setParamReport(report);
                rptParam.setParamName(paramName);
                rptParam.setParamDesc(paramName + " Description");
                if (parameter.isRequired())
                  rptParam.setParamRequired("true");
                else
                  rptParam.setParamRequired("false");
                String dataType = parameter.getDataType();
                String[] parts = dataType.split("\\.");
                int x = parts.length - 1;
                rptParam.setParamDataType(parts[x]);
                if (rptParam.getParamDataType().equals("Date") || rptParam.getParamDataType().equals("Timestamp")) {
                  rptParam.setParamDateFormat("yy/oo");
                }
                rptParam.setParamType("VALUE");
                rptParams.add(rptParam);
              }
          }

          is.close();
        } catch (Exception e) {
           doAdminRptAdd(req, resp);
           req.setAttribute(ConstRpt.MSG, "Error loading BaseReport. error = " + e);
           return;
        }

        Long rptId = reportService.addReport(report);

        for (RptParam rptParam : rptParams) {
         rptParam.setParamReport(report);
         Long paramId = reportService.addRptParam(rptParam);
        }

        for (RptSort rptSort : rptSorts) {
         rptSort.setSortReport(report);
         Long sortId = reportService.addRptSort(rptSort);
        }

        report.setRptParam(rptParams);
        report.setRptSort(rptSorts);
        String result = reportService.editReport(report);

        String importMsg = "Report Loaded ID = " + rptId.toString();

        req.setAttribute(ConstRpt.MSG, importMsg);

        doAdminHome(req, resp);
    }


   /**
    * The doAdminRptEdit method calls the AdminReport Edit web page.
