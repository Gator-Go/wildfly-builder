   /**
    * The doAdminRptDeleteAction method deletes the AdminReport from delete web page data.
    *
    * @param req A HttpServletRequest object containing the request data.
    * @param resp A HttpServletResponse object containing the response data.
    */
    public void doAdminRptEditAction(HttpServletRequest req, HttpServletResponse resp) throws ServletException, IOException {

        Long reportId = new Long(req.getParameter(ConstRpt.ID));
        Report report = reportService.getReport(reportId);
        dataHelper.editReport(req, report);

        String result = reportService.editReport(report);
        if (!result.equals("success"))
        {
            req.setAttribute(ConstRpt.MSG, "Report Edit Error " + result);
            log.warning("result = " + result);
        }
        else
            req.setAttribute(ConstRpt.MSG, "Report Record Edited Successfully");

        doAdminHome(req, resp);
    }


