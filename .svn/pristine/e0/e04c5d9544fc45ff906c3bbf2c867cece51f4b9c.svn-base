    private final static int RowsToPage = 30;

    public void doReportHome(HttpServletRequest req, HttpServletResponse resp) throws ServletException, IOException {

        List<Report> reports = reportService.findAllReports();
        req.setAttribute("reports", reports);
        req.setAttribute(ConstRpt.OP, ConstRpt.OP_HOME);
log.info("*** In doReportHome *** " + ConstRpt.OP + "*** " + ConstRpt.OP_HOME);
    }


    public void doGenRpt(HttpServletRequest req, HttpServletResponse resp) throws ServletException, IOException {

        String id = req.getParameter(ConstRpt.ID);
        Long reportId = new Long(id);
        Report report = reportService.getReport(reportId);

        dataHelper.loadGenerateReport(req, report);
        req.setAttribute(ConstRpt.OP_ACTION, ConstRpt.OP_GEN_RPT_ACTION);
        req.setAttribute(ConstRpt.OP_BACK, ConstRpt.OP_HOME);
        req.setAttribute(ConstRpt.OP, ConstRpt.OP_GEN_RPT);

    }

    public void doGenRptAction(HttpServletRequest req, HttpServletResponse resp)
       throws ServletException, IOException
    {

         String id = req.getParameter("id");

         String reportName = req.getParameter("reportName");
         String reportJrxml = req.getParameter("reportJrxml");
         String reportMimeType = reportJrxml.split("\\.")[1];
         String mimeType = req.getParameter("mimeType");
         String sortOption = req.getParameter("sortOption");
         String nbrParams = req.getParameter("nbrParams");
         Integer nbrParamsInt = Integer.parseInt(nbrParams);

         log.info("*** In doReportAction *** " + reportJrxml + "*** " + mimeType);

        InputStream is = null;
        OutputStream os = null;

        try {
           String inpath = System.getProperty("com.pojomax.sync.app.report.dir") + reportJrxml;
           is = new FileInputStream(inpath );

           String outpath = System.getProperty("com.pojomax.sync.app.report.dir") + reportName + "." + mimeType;
           os = new FileOutputStream(outpath );
        } catch (FileNotFoundException e) {
           log.warning("error getting file stream. error = " + e);
           throw new ServletException("error getting file stream. error = " + e);
        }

	Connection conn = null;
        try {
	  conn = dataSource.getConnection();

// IMMEDIATE CONNECTION TEST
        log.info(">>> Testing DB connection...");
        if (conn == null) {
            throw new SQLException("DataSource returned null connection");
        }
        if (conn.isClosed()) {
            throw new SQLException("Connection is already closed");
        }

        try (var stmt = conn.createStatement();
             var rs = stmt.executeQuery("SELECT 1")) {
            if (rs.next()) {
                log.info(">>> DB CONNECTION TEST: SUCCESS");
            }
        } catch (Exception e) {
            log.severe(">>> DB CONNECTION TEST FAILED: " + e.getMessage());
            throw e;
        }

          BaseReport report = BaseReport.newInstance(reportMimeType, is);

          log.info("jrxml Name = " + report.getName());

          Map<String, ReportParameter> parameters = report.getParameters();
	  if (parameters == null) {
	      parameters = new HashMap<>();
	  }
          for (Map.Entry<String, ReportParameter> entry : parameters.entrySet()) {
              String key = entry.getKey();
              ReportParameter parameter = entry.getValue();
              String paramName = parameter.getName();
              log.info("jrxml Parameter Key = " + key + "   Parameter Name = " + paramName);
          }

          ReportFormat type = null;

          if (mimeType.equals("csv"))
            type = new ReportFormat(ReportFormat.Type.MIME_TYPE_CSV);
          if (mimeType.equals("html"))
            type = new ReportFormat(ReportFormat.Type.MIME_TYPE_HTML);
          if (mimeType.equals("xls"))
            type = new ReportFormat(ReportFormat.Type.MIME_TYPE_EXCEL);
          if (mimeType.equals("docx"))
            type = new ReportFormat(ReportFormat.Type.MIME_TYPE_DOCX);
          if (mimeType.equals("pdf"))
            type = new ReportFormat(ReportFormat.Type.MIME_TYPE_PDF);
          if (mimeType.equals("rtf"))
            type = new ReportFormat(ReportFormat.Type.MIME_TYPE_RTF);
          if (mimeType.equals("txt"))
            type = new ReportFormat(ReportFormat.Type.MIME_TYPE_PLAINTEXT);

          Map paramMap = new HashMap();

          int x = 1;
          while (x <= nbrParamsInt.intValue()) {
            Integer count = new Integer(x);
            String paramName = req.getParameter("paramName." + count.toString());
            String paramValue = req.getParameter("paramValue." + count.toString());
            log.info("Web Page paramName = " + paramName + "   paramValue = " + paramValue);
            String paramDataType = req.getParameter("paramDataType." + count.toString());
            String paramDateFormat = req.getParameter("paramDateFormat." + count.toString());
            if(paramValue != null && !paramValue.isEmpty() && !paramValue.equals("All")) {
              if (paramDataType.equals("String"))
                paramMap.put(paramName, paramValue);

              if (paramDataType.equals("Integer")) {
                Integer intValue = Integer.parseInt(paramValue);
                paramMap.put(paramName, intValue);
              }

              if (paramDataType.equals("Long")) {
                Long longValue = Long.parseLong(paramValue);
                paramMap.put(paramName, longValue);
              }

              if (paramDataType.equals("Float")) {
                Float floatValue = Float.parseFloat(paramValue);
                paramMap.put(paramName, floatValue);
              }

              if (paramDataType.equals("Date")) {
                if (paramDateFormat.equals("yy/oo")) {
                  Date dateValue = ConstRpt.formatDOYDate.parse(paramValue);
                  paramMap.put(paramName, dateValue);
                }
                if (paramDateFormat.equals("yy/oo 00:00")) {
                  Date dateValue = ConstRpt.formatDOYDateHourMinute.parse(paramValue);
                  paramMap.put(paramName, dateValue);
                }
              }

              if (paramDataType.equals("Timestamp")) {
                if (paramDateFormat.equals("yy/oo")) {
                  Date dateValue = ConstRpt.formatDOYDate.parse(paramValue);
                  Timestamp timestampValue = new Timestamp(dateValue.getTime());
                  paramMap.put(paramName, timestampValue);
                }
                if (paramDateFormat.equals("yy/oo 00:00")) {
                  Date dateValue = ConstRpt.formatDOYDateHourMinute.parse(paramValue);
                  Timestamp timestampValue = new Timestamp(dateValue.getTime());
                  paramMap.put(paramName, timestampValue);
                }
              }
            }
            ++x;
          }

          if (!sortOption.equals("None"))
            paramMap.put(sortOption, "true");

          report.render(type, paramMap, os, conn);

        } catch (Exception e) {
           log.warning("error getting BaseReport. error = " + e);
           throw new ServletException("error getting BaseReport. error = " + e);
	}
	
        is.close();
        os.close();

        RptList rptList = new RptList();
        rptList.setRptName(reportName + "." + mimeType);
        String result = reportService.addRptList(rptList);
    }

