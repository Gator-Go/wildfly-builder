<%@ page import="ppp.ppp.ppp.servlet.ControllerEnums" %>
<%
String op = (String)request.getAttribute("op");
if (op == null) {
  op = "Home";
}
String role = (String)request.getAttribute("role");
if (role == null)
    role = "GUEST";
pageContext.setAttribute("role", role);

String jsp = ControllerEnums.Calls.get(op).getJsp();
String tabIdx2 = ControllerEnums.Calls.get(op).getTabIdx2();
%>
<div class='pojo-section'>
<div class='pojo-section-body'>
<div id="reportTabs">
	<ul>

	    <li><a href="#ReportList">Report List</a></li>
	    <c:if test="${ role != 'GUEST' }">
		<li><a href="#GenReport">Generate Report</a></li>
	    </c:if>
	</ul>

	<div id="ReportList">
	<% if (tabIdx2 == "0") { %>
	  <jsp:include page="<%= jsp %>" />
	<% } %>
	</div>

	<c:if test="${ role != 'GUEST' }">
	  <div id="GenReport">
	  <% if (tabIdx2 == "1") { %>
	    <jsp:include page="<%= jsp %>" />
	  <% } %>
	  </div>
	</c:if>

</div>
</div>
</div>
