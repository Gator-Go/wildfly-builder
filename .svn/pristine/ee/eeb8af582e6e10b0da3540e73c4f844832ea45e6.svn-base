def loadListHeading(theTable) {

   def sortClass = []
   for ( t in appTables.appTable ) {
      def tableClass = t.'@className'
      if (tableClass.equals(theTable)) {

         for ( f in t.appField ) {
            if (f.'@listFlag'.equals("yes") && !(f.'@codeType'.equals("Camera")
                                              || f.'@codeType'.equals("Post")
                                              || f.'@codeType'.equals("Video")
                                              || f.'@codeType'.equals("Thumbnail"))) {
               myData = new MyData()
               myData.theOrder = f.'@listOrder'
               myData.theData = f.'@displayName'
               sortClass.add(myData)
            }

         }
      }
   }
   sortClass.sort{it.theOrder}

   def theCode = " ID"
   for ( i in sortClass ) {
      theCode = theCode + " | " + i.theData
   }
   theCode
}


def loadListFields(theTable) {

   def char myReturn = '\r'
   def char newLine = '\n'

   def sortClass = []
   for ( t in appTables.appTable ) {
      def tableClass = t.'@className'
      if (tableClass.equals(theTable)) {

         for ( f in t.appField ) {
            if (f.'@listFlag'.equals("yes") && !(f.'@codeType'.equals("Camera")
                                              || f.'@codeType'.equals("Post")
                                              || f.'@codeType'.equals("Video")
                                              || f.'@codeType'.equals("Thumbnail"))) {
               myData = new MyData()
               myData.theOrder = f.'@listOrder'
               myData.theType = f.'@codeType'
               myData.theName = f.'@classFieldName'
               myData.theFormat = f.'@format'
               sortClass.add(myData)
            }
         }
      }
   }
   sortClass.sort{it.theOrder}

   def theTypeS = "\"%d"
   def theNameS = "         obj.getId()"
   for ( i in sortClass ) {
      theTypeS = theTypeS + " | "
      theNameS = theNameS + ", "

      if (i.theType.equals("Date")) {
         theTypeS = theTypeS + "%s"
         theNameS = theNameS + "formatDate.format(obj.get" + i.theName + "())"
      }
      else if (i.theType.equals("DateTime")) {
         theTypeS = theTypeS + "%s"
         theNameS = theNameS + "formatDateTime.format(obj.get" + i.theName + "())"
      }
      else if (i.theType.equals("Money")) {
         theTypeS = theTypeS + "%s"
         theNameS = theNameS + "DecimalFormat.getCurrencyInstance().format(obj.get" + i.theName + "())"
      }
      else
      {
         theTypeS = theTypeS + i.theFormat
         theNameS = theNameS + "obj.get" + i.theName + "()"
      }
   }
   theTypeS = theTypeS + "\","

   theTypeS + myReturn + newLine + theNameS
}


def loadDisplayFields(theTable) {

   def char myReturn = '\r'
   def char newLine = '\n'

   def sortClass = []
   for ( t in appTables.appTable ) {
      def tableClass = t.'@className'
      if (tableClass.equals(theTable)) {

         for ( f in t.appField ) {
            if (f.'@listFlag'.equals("yes") && !(f.'@codeType'.equals("Camera")
                                              || f.'@codeType'.equals("Post")
                                              || f.'@codeType'.equals("Video")
                                              || f.'@codeType'.equals("Thumbnail"))) {
               myData = new MyData()
               myData.theOrder = f.'@listOrder'
               myData.theType = f.'@codeType'
               myData.theName = f.'@objFieldName'
               myData.theFormat = f.'@format'
               sortClass.add(myData)
            }
         }
      }
   }
   sortClass.sort{it.theOrder}

   def firstTime = 1
   def theTypeS = "\""
   def theNameS = "         "
   for ( i in sortClass ) {
      if (firstTime == 1) {
        firstTime = 0
      } else {
        theTypeS = theTypeS + " "
        theNameS = theNameS + ", "
      }
      if (i.theType.equals("Date")) {
         theTypeS = theTypeS + "%s"
         theNameS = theNameS + "formatDate.format(" + i.theName + ")"
      }
      else if (i.theType.equals("DateTime")) {
         theTypeS = theTypeS + "%s"
         theNameS = theNameS + "formatDateTime.format(" + i.theName + ")"
      }
      else if (i.theType.equals("Money")) {
         theTypeS = theTypeS + "%s"
         theNameS = theNameS + "DecimalFormat.getCurrencyInstance().format(" + i.theName + ")"
      }
      else
      {
         theTypeS = theTypeS + i.theFormat
         theNameS = theNameS + i.theName
      }
   }
   theTypeS = theTypeS + "\","

   theTypeS + myReturn + newLine + theNameS
}



def createEnums(theField) {

   def char myReturn = '\r'
   def char newLine = '\n'
   def theCode = ""
   for ( e in appEnums.appEnum ) {
      def appField = e.'@appField'
      if (appField.equals(theField)) {

         def firstTime = "yes"
         for ( ee in e.theEnum ) {

            if (firstTime.equals("yes")) {
               firstTime = "no"
            }
            else {
               theCode = theCode + "," + myReturn + newLine
            }
            theCode = theCode + "     " + ee.'@classValue' + "(\"" + ee.'@codeValue' + "\")"
         }
         theCode = theCode + ";" + myReturn + newLine
      }
   }
   theCode
}


def createCode(theTable, theCodeKey, theField) {

   def char myReturn = '\r'
   def char newLine = '\n'
   def myCode = ""

   for ( c in appCodes.appCode ) {
      def codeKey = c.'@codeKey'
      def codeType = c.'@codeType'
      if (codeKey.equals(theCodeKey)) {

         def theCode = ""
         for ( cc in c.code ) {

            def int x = cc.'@indent' as int
            def indent = ""
            while ( x-- > 0 ) {
              indent = indent + " "
            }

            theCode = theCode + indent
            theCode = theCode + cc.text() + myReturn + newLine
         }

         for ( t in appTables.appTable ) {
           def tableClass = t.'@className'
           if (tableClass.equals(theTable)) {
             for ( f in t.appField ) {
               if (codeType.equals("ALL") || codeType.equals(f.'@codeType') &&
                  (theField.equals("ALL") ||theField.equals(f.'@classFieldName')))
               {
                  def oldCode = theCode
                  def newCode = ""

                  if (oldCode.contains("___LOAD_ENUMS___")) {
                     def insertEnums = createEnums(f.'@classFieldName')
                     newCode = oldCode.replaceAll("___LOAD_ENUMS___", insertEnums)
                     oldCode = newCode
                  }

                  if (oldCode.contains("___DAO_SET_SEQ___")) {
                     newCode = oldCode.replace("___DAO_SET_SEQ___", daoSetSeq.toString())
                     oldCode = newCode
                     daoSetSeq++
                  }

                  if (oldCode.contains("___PP_DAO_SET_SEQ___")) {
                     newCode = oldCode.replace("___PP_DAO_SET_SEQ___", daoSetSeq.toString())
                     oldCode = newCode
                     daoSetSeq++
                  }

                  if (oldCode.contains("___STATIC_SET_SEQ___")) {
                     newCode = oldCode.replace("___STATIC_SET_SEQ___", staticSetSeq.toString())
                     oldCode = newCode
                     staticSetSeq++
                  }

                  if (oldCode.contains("___PP_STATIC_SET_SEQ___")) {
                     newCode = oldCode.replace("___PP_STATIC_SET_SEQ___", staticSetSeq.toString())
                     oldCode = newCode
                     staticSetSeq++
                  }

                  if (oldCode.contains("___PP_PP_STATIC_SET_SEQ___")) {
                     newCode = oldCode.replace("___PP_PP_STATIC_SET_SEQ___", staticSetSeq.toString())
                     oldCode = newCode
                     staticSetSeq++
                  }

                  if (oldCode.contains("___PP_PP_PP_STATIC_SET_SEQ___")) {
                     newCode = oldCode.replace("___PP_PP_PP_STATIC_SET_SEQ___", staticSetSeq.toString())
                     oldCode = newCode
                     staticSetSeq++
                  }

                  if (oldCode.contains("___JSP_TR_START_SEQ_3___")) {
                     if (seq3nbr == 1)
                        newCode = oldCode.replace("___JSP_TR_START_SEQ_3___", "            <tr>")
                     else
                        newCode = oldCode.replace("___JSP_TR_START_SEQ_3___", "___skip___")
                     oldCode = newCode
                  }

                  if (oldCode.contains("___JSP_TR_DETAIL_SEQ_3___")) {
                     if (seq3nbr == 1)
                        newCode = oldCode.replace("___JSP_TR_DETAIL_SEQ_3___", "            <tr class='detail' style='display:none;'>")
                     else
                        newCode = oldCode.replace("___JSP_TR_DETAIL_SEQ_3___", "___skip___")
                     oldCode = newCode
                  }

                  if (oldCode.contains("___JSP_TR_END_SEQ_3___")) {
                     if (seq3nbr == 3) {
                        newCode = oldCode.replace("___JSP_TR_END_SEQ_3___", "            </tr>")
                        seq3nbr = 1
                     } else {
                        newCode = oldCode.replace("___JSP_TR_END_SEQ_3___", "___skip___")
                        seq3nbr++
                     }
                     oldCode = newCode
                  }

                  if (oldCode.contains("___JSP_TR_FINALLY_3___")) {
                     if (seq3nbr == 1) {
                        newCode = oldCode.replace("___JSP_TR_FINALLY_3___", "")
                     } else {
                        newCode = oldCode.replace("___JSP_TR_FINALLY_3___", "            </tr>")
                        seq3nbr = 1
                     }
                     oldCode = newCode
                  }

                  newCode = oldCode.replaceAll("FFFFF", f.'@dbName')
                  oldCode = newCode
                  newCode = oldCode.replaceAll("Fffff", f.'@classFieldName')
                  oldCode = newCode
                  newCode = oldCode.replaceAll("fffff", f.'@objFieldName')
                  oldCode = newCode
                  newCode = oldCode.replaceAll("ttttt", f.'@fieldType')
                  oldCode = newCode
                  newCode = oldCode.replaceAll("sssss", f.'@fieldSize')
                  oldCode = newCode
                  newCode = oldCode.replaceAll("ddddd", f.'@scale')
                  oldCode = newCode
                  newCode = oldCode.replaceAll("DFDFD", f.'@displayName')
                  oldCode = newCode
                  newCode = oldCode.replaceAll("BFBFB", f.'@blobNameFld')
                  oldCode = newCode
                  newCode = oldCode.replaceAll("FTFTF", f.'@format')
                  oldCode = newCode
                  newCode = oldCode.replaceAll("CPCPC", f.'@classPlural')
                  oldCode = newCode
                  newCode = oldCode.replaceAll("MMMMM", "\\\\\\\$")
                  oldCode = newCode
                  newCode = oldCode.replaceAll("AAAAA", "&")
                  oldCode = newCode
                  newCode = oldCode.replaceAll("LLLLL", "<")
                  oldCode = newCode
                  newCode = oldCode.replaceAll("GGGGG", ">")
                  oldCode = newCode
                  newLineCode = ""
                  oldCode.eachLine { line->
                    if (line.contains("___TEST_DATA___") || line.contains("___TEST_DATA2___")) {
                      def newCodeLine = loadTestData(line, f)
                      newLineCode = newLineCode + newCodeLine + myReturn + newLine
                    }
                    else
                      newLineCode = newLineCode + line + myReturn + newLine
                  }
                  myCode = myCode + newLineCode
               }
             }
           }
         }

      }
   }
   myCode
}


def createMultiFilesProc(fileName, thePath, theDir) {



   for ( n in appTables.appTable ) {
      seq3nbr = 1
      daoSetSeq = 1
      staticSetSeq = 700
      newFileName = fileName.replaceAll("Yyyyy", n.'@className')
      if (newFileName.contains("yfyfy")) {
         fileName = newFileName
         newFileName = fileName.replaceAll("yfyfy", n.'@fileName')
      }

      def oldFilePath = thePath + "/" + fileName
      def newFilePath = theDir + "/" + newFileName

      def oldFile = new File(oldFilePath).text
      def newFile = ""

      for ( c in appCodes.appCode ) {
         def theCodeKey = c.'@codeKey'

         if (oldFile.contains(theCodeKey)) {

            def insertCode = createCode(n.'@className', theCodeKey, "ALL")
            if (insertCode.equals("")) {
              def upFile = oldFile.replaceAll(theCodeKey, "___skip___")
              oldFile = upFile
            } else {
              def upFile = oldFile.replaceAll(theCodeKey, insertCode)
              oldFile = upFile
            }
         }
         if (oldFile.contains("___JSP_LIST_HEADING___")) {
            def insertJspListHeading = loadJspListHeading(n.'@className')
            def upFile = oldFile.replaceAll("___JSP_LIST_HEADING___", insertJspListHeading)
            oldFile = upFile
         }
         if (oldFile.contains("___JSP_LIST_BODY___")) {
            def insertJspListBody = loadJspListBody(n.'@className')
            def upFile = oldFile.replaceAll("___JSP_LIST_BODY___", insertJspListBody)
            oldFile = upFile
         }
         if (oldFile.contains("___LOAD_LIST_HEADING___")) {
            def insertListHeading = loadListHeading(n.'@className')
            def upFile = oldFile.replaceAll("___LOAD_LIST_HEADING___", insertListHeading)
            oldFile = upFile
         }
         if (oldFile.contains("___LOAD_LIST_FIELDS___")) {
            def insertListFields = loadListFields(n.'@className')
            def upFile = oldFile.replaceAll("___LOAD_LIST_FIELDS___", insertListFields)
            oldFile = upFile
         }
         if (oldFile.contains("___LOAD_DISPLAY_FIELDS___")) {
            def insertDisplayFields = loadDisplayFields(n.'@className')
            def upFile = oldFile.replaceAll("___LOAD_DISPLAY_FIELDS___", insertDisplayFields)
            oldFile = upFile
         }
      }

      newFile = insertAppCopyrights(oldFile)
      oldFile = newFile
      newFile = insertAppAuthors(oldFile)
      oldFile = newFile
      newFile = insertAppNames(oldFile)
      oldFile = newFile
      newFile = insertAppPackages(oldFile)
      oldFile = newFile
      newFile = oldFile.replaceAll("yyyyys", n.'@objPlural')
      oldFile = newFile
      newFile = oldFile.replaceAll("Yyyyys", n.'@classPlural')
      oldFile = newFile
      newFile = oldFile.replaceAll("yyyyy", n.'@objName')
      oldFile = newFile
      newFile = oldFile.replaceAll("Yyyyy", n.'@className')
      oldFile = newFile
      newFile = oldFile.replaceAll("YYYYY", n.'@dbName')
      oldFile = newFile
      newFile = oldFile.replaceAll("yfyfy", n.'@fileName')
      oldFile = newFile
      newFile = oldFile.replaceAll("DDDDD", n.'@displayName')

      def char myReturn = '\r'
      def char newLine = '\n'
      def cleanFile = ""
      def titTat = "tit"
      newFile.eachLine { line->
        if (!line.equals("___skip___"))
          if (line.equals("___DIV_CLASS___")) {
            if (titTat.equals("tit")) {
              cleanFile = cleanFile + "<div class='pojo-section-alternate'>" + myReturn + newLine
              titTat = "tat"
            }
            else {
              cleanFile = cleanFile + "<div class='pojo-section-body'>" + myReturn + newLine
              titTat = "tit"
            }
          }
          else
            cleanFile = cleanFile + line + myReturn + newLine
      }
      new File(newFilePath).write(cleanFile)
   }
}





