            if (f.'@listFlag'.equals("yes")) {
               myData = new MyData()
               myData.theOrder = f.'@listOrder'
               myData.theType = f.'@codeType'
               myData.theName = f.'@classFieldName'
               sortClass.add(myData)
            }
         }
      }
   }
   sortClass.sort{it.theOrder}

   def theCode = ""
   for ( i in sortClass ) {
      if (i.theType.equals("String")) {
         def insertCode = createCode(theTable, "___JSP_LIST_HEAD_STRING___", i.theName)
         theCode = theCode + insertCode
      }
      else if (i.theType.equals("Enum")) {
         def insertCode = createCode(theTable, "___JSP_LIST_HEAD_ENUM___", i.theName)
         theCode = theCode + insertCode
      }
      else if (i.theType.equals("Clob")) {
