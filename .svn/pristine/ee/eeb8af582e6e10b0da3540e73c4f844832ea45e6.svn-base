         theCode = theCode + insertCode
      }
      else if (i.theType.equals("Long")) {
         def insertCode = createCode(theTable, "___JSP_LIST_HEAD_LONG___", i.theName)
         theCode = theCode + insertCode
      }
      else if (i.theType.equals("Double")) {
         def insertCode = createCode(theTable, "___JSP_LIST_HEAD_DOUBLE___", i.theName)
         theCode = theCode + insertCode
      }
      else if (i.theType.equals("BigDecimal")) {
         def insertCode = createCode(theTable, "___JSP_LIST_HEAD_BIG_DECIMAL___", i.theName)
         theCode = theCode + insertCode
      }
      else if (i.theType.equals("Money")) {
         def insertCode = createCode(theTable, "___JSP_LIST_HEAD_MONEY___", i.theName)
         theCode = theCode + insertCode
      }
      else if (i.theType.equals("Loc")) {
         def insertCode = createCode(theTable, "___JSP_LIST_HEAD_LOC___", i.theName)
         theCode = theCode + insertCode
      }
      else if (i.theType.equals("CurrentLoc")) {
         def insertCode = createCode(theTable, "___JSP_LIST_HEAD_CURRENT_LOC___", i.theName)
         theCode = theCode + insertCode
      }
      else if (i.theType.equals("Date")) {
         def insertCode = createCode(theTable, "___JSP_LIST_HEAD_DATE___", i.theName)
         theCode = theCode + insertCode
      }
      else if (i.theType.equals("DateTime")) {
         def insertCode = createCode(theTable, "___JSP_LIST_HEAD_DATE_TIME___", i.theName)
         theCode = theCode + insertCode
      }
      else if (i.theType.equals("Camera")) {
         def insertCode = createCode(theTable, "___JSP_LIST_HEAD_CAMERA___", i.theName)
         theCode = theCode + insertCode
      }
      else if (i.theType.equals("Video")) {
         def insertCode = createCode(theTable, "___JSP_LIST_HEAD_VIDEO___", i.theName)
         theCode = theCode + insertCode
      }
      else if (i.theType.equals("Thumbnail")) {
         def insertCode = createCode(theTable, "___JSP_LIST_HEAD_THUMBNAIL___", i.theName)
         theCode = theCode + insertCode
      }
      else if (i.theType.equals("Post")) {
         def insertCode = createCode(theTable, "___JSP_LIST_HEAD_POST___", i.theName)
         theCode = theCode + insertCode
      }
      else if (i.theType.equals("One2ManyParent")) {
         def insertCode = createCode(theTable, "___JSP_LIST_HEAD_ONE2MANY_PARENT___", i.theName)
         theCode = theCode + insertCode
      }
      else if (i.theType.equals("One2ManyParentAlert")) {
         def insertCode = createCode(theTable, "___JSP_LIST_HEAD_ONE2MANY_PARENT_ALERT___", i.theName)
