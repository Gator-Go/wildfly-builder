def createFunc(theFuncKey) {

   def char myReturn = '\r'
   def char newLine = '\n'
   def theFunc = ""

   for ( f in appFuncs.appFunc ) {
      def funcKey = f.'@funcKey'

      if (funcKey.equals(theFuncKey)) {

         for ( ff in f.func ) {
            def int x = ff.'@indent' as int
            def indent = ""
            while ( x-- > 0 ) {
              indent = indent + " "
            }

            theFunc = theFunc + indent
            theFunc = theFunc + ff.text() + myReturn + newLine

         }
      }
   }

   def newFunc = theFunc

   theFunc = newFunc.replaceAll("LLLLL", "<")
   newFunc = theFunc
   theFunc = newFunc.replaceAll("GGGGG", ">")
   newFunc = theFunc
   theFunc = newFunc.replaceAll("MMMMM", "\\\\\\\$")

//   theFunc + "E" + myReturn + newLine
}




def createMultiFunctionProc(fileName, thePath, theDir, allCodeTypes) {

   jspSetSeq = 2
   jspSetAdminSeq = 4

   newFileName = insertAppNames(fileName)
   newFileName = insertTableNames(newFileName)

   def oldFilePath = thePath + "/" + fileName
   def newFilePath = theDir + "/" + newFileName

   def oldFile = new File(oldFilePath).text
   def newFile = ""


   for ( f in appFuncs.appFunc ) {

      if (!allCodeTypes.contains(f.'@codeType')) {
         continue }

      def theFuncKey = f.'@funcKey'
      def tblOrder = f.'@tblOrder'
      def codeNbr = f.'@codeNbr'

      def theFunc = ""
      if (oldFile.contains(theFuncKey)) {

         def insertFunc = createFunc(theFuncKey)
         def newFunc = ""
         def oldFunc = ""




         if (codeNbr.equals("Table")) {

           int rr = appTables.appTable.size()
           for (int ff = 0; rr > 0; ff++) {
            rr--
            if (tblOrder.equals("reverse"))
               n = appTables.appTable.get(rr)
            else
               n = appTables.appTable.get(ff)

            oldFunc = insertFunc
            for ( c in appCodes.appCode ) {
               def theCodeKey = c.'@codeKey'

               if (oldFunc.contains(theCodeKey)) {
                  def insertCode = createCode(n.'@className', theCodeKey, "ALL")
                  if (!insertCode.equals("")) {
                    newFunc = oldFunc.replaceAll(theCodeKey, insertCode)
                    oldFunc = newFunc
                  }
               }

            }

            newFunc = oldFunc.replaceAll("yyyyys", n.'@objPlural')
            oldFunc = newFunc
            newFunc = oldFunc.replaceAll("Yyyyys", n.'@classPlural')
            oldFunc = newFunc
            newFunc = oldFunc.replaceAll("yyyyy", n.'@objName')
            oldFunc = newFunc
            newFunc = oldFunc.replaceAll("Yyyyy", n.'@className')
            oldFunc = newFunc
            newFunc = oldFunc.replaceAll("YYYYY", n.'@dbName')
            oldFunc = newFunc
            newFunc = oldFunc.replaceAll("DDDDD", n.'@displayName')
            oldFunc = newFunc

            if (oldFunc.contains("___JSP_SET_SEQ___")) {
              newFunc = oldFunc.replaceAll("___JSP_SET_SEQ___", jspSetSeq.toString())
              oldFunc = newFunc
              jspSetSeq++
            }

            if (oldFunc.contains("___JSP_SET_ADMIN_SEQ___")) {
              newFunc = oldFunc.replaceAll("___JSP_SET_ADMIN_SEQ___", jspSetAdminSeq.toString())
              oldFunc = newFunc
              jspSetAdminSeq++
            }

            if (!newFunc.equals(insertFunc))
              theFunc = theFunc + newFunc

           }

           def upFile = oldFile.replaceAll(theFuncKey, theFunc)
           oldFile = upFile
         }


         if (codeNbr.equals("Once")) {

            if (insertFunc.contains("___JSP_SEQ___")) {
              newFunc = insertFunc.replaceAll("___JSP_SEQ___", jspSetSeq.toString())
              insertFunc = newFunc
            }

            if (insertFunc.contains("___JSP_SET_SEQ___")) {
              newFunc = insertFunc.replaceAll("___JSP_SET_SEQ___", jspSetSeq.toString())
              insertFunc = newFunc
              jspSetSeq++
            }

            if (insertFunc.contains("___JSP_SET_ADMIN_SEQ___")) {
              newFunc = insertFunc.replaceAll("___JSP_SET_ADMIN_SEQ___", jspSetAdminSeq.toString())
              insertFunc = newFunc
              jspSetAdminSeq++
            }

            def upFile = oldFile.replaceAll(theFuncKey, insertFunc)
            oldFile = upFile

         }

      }

   }


   newFile = insertAppCopyrights(oldFile)
   newFile = insertAppAuthors(newFile)
   newFile = insertAppNames(newFile)
   newFile = insertAppPackages(newFile)
   newFile = insertTableNames(newFile)

   def char myReturn = '\r'
   def char newLine = '\n'
   def cleanFile = ""
   newFile.eachLine { line->
     if (!line.startsWith("___"))
       cleanFile = cleanFile + line + myReturn + newLine
   }

   new File(newFilePath).write(cleanFile)

}




def createMultiFilesCodeTypeProc(fileName, thePath, theDir, codeType) {

   for ( n in appTables.appTable ) {

      for ( f in n.appField ) {

         if (codeType.equals(f.'@codeType')) {

            def theFileName = fileName.replaceAll("Yyyyy", n.'@className')
            def newFileName = theFileName.replaceAll("Fffff", f.'@classFieldName')

            def oldFilePath = thePath + "/" + fileName
            def newFilePath = theDir + "/" + newFileName

            def oldFile = new File(oldFilePath).text
            def newFile = ""

            if (oldFile.contains("___LOAD_LIST_HEADING_M2M___")) {
               def insertListHeading = loadListHeading(f.'@classFieldName')
               def upFile = oldFile.replaceAll("___LOAD_LIST_HEADING_M2M___", insertListHeading)
               oldFile = upFile
            }
            if (oldFile.contains("___LOAD_LIST_FIELDS_M2M___")) {
               def insertListFields = loadListFieldsM2M(f.'@classFieldName')
               def upFile = oldFile.replaceAll("___LOAD_LIST_FIELDS_M2M___", insertListFields)
               oldFile = upFile
            }
            if (codeType.equals("Many2ManyOwner")) {
               def many2many = getMany2Many(f.'@classFieldName', n.'@className')
               if (many2many != null) {
                  def upFile = oldFile.replaceAll("RRRRR_NUMBER", many2many.'@number')
                  oldFile = upFile
               }
            }

            newFile = insertAppCopyrights(oldFile)
            oldFile = newFile
            newFile = insertAppAuthors(oldFile)
            oldFile = newFile
            newFile = insertAppNames(oldFile)
            oldFile = newFile
            newFile = insertAppPackages(oldFile)
            oldFile = newFile
            newFile = oldFile.replaceAll("yyyyys", n.'@objPlural')
            oldFile = newFile
            newFile = oldFile.replaceAll("Yyyyys", n.'@classPlural')
            oldFile = newFile
            newFile = oldFile.replaceAll("yyyyy", n.'@objName')
            oldFile = newFile
            newFile = oldFile.replaceAll("Yyyyy", n.'@className')
            oldFile = newFile
            newFile = oldFile.replaceAll("YYYYY", n.'@dbName')
            oldFile = newFile
            newFile = oldFile.replaceAll("DDDDD", n.'@displayName')
            oldFile = newFile
            newFile = oldFile.replaceAll("FFFFF", f.'@dbName')
            oldFile = newFile
            newFile = oldFile.replaceAll("Fffff", f.'@classFieldName')
            oldFile = newFile
            newFile = oldFile.replaceAll("fffff", f.'@objFieldName')
            oldFile = newFile
            newFile = oldFile.replaceAll("ttttt", f.'@fieldType')
            oldFile = newFile
            newFile = oldFile.replaceAll("sssss", f.'@fieldSize')

            new File(newFilePath).write(newFile)

         }
      }
   }
}





void createApp ( templatePath, appDir ) {

   def fileList = new File(templatePath).list().toList()
   def appPackageList = new ArrayList(appNames.appPackage.'@newPackage')
   def appPackageIt = appPackageList.iterator()
//while(appPackageIt.hasNext())
//   println "Package name '" + appPackageIt.next().toString() + "'"

   for ( i in fileList ) {
      def inFile = templatePath + "/" + i
      def f1= new File(inFile)
      if ( f1.isDirectory() ) {
println "found directory " + i
        newDir = insertAppPackages(i)
        newDir = insertAppNames(newDir)
        
        boolean isPackage = false
        appPackageIt = appPackageList.iterator()
        while(appPackageIt.hasNext() && !isPackage)
             isPackage = newDir.equals(appPackageIt.next().toString())

        def newAppDir
        if (isPackage) {
println "Found a package called '" + newDir + "'"
           newAppDir = appDir
           int startIndex=0, endIndex=0
           while(endIndex != -1) {
                endIndex = newDir.indexOf("/", startIndex)
                if (endIndex != -1)
                   newAppDir += "/" + newDir.substring(startIndex, endIndex)
                else
                   newAppDir += "/" + newDir.substring(startIndex)
                def mkdir= new File(newAppDir)
                mkdir.mkdir()
                startIndex = endIndex + 1
           } 
        }
        else {
           def mkdir= new File(appDir + "/" + newDir)
           mkdir.mkdir()
           newAppDir = appDir + "/" + newDir
        }

        createApp ( inFile, newAppDir )

      } else {
println "found file " + i

        if(i.endsWith(".gif") || i.endsWith(".jar") || i.endsWith(".png") || i.endsWith(".jpg")) {
           File src = new File(templatePath + "/" + i)
           new File(appDir + "/" + i).withOutputStream { out ->
              out.write src.readBytes()
           }
        } else {
           def defaultCode = "yes"
           for ( p in appProcs.appProc ) {
              def fileName = p.'@fileName'

               if (fileName.equals(i)) {
                  def procName = p.'@procName'
                  def codeType = p.'@codeType'
                  def allCodeTypes = appCodeTypes.appCodeType.'@codeType'*.toString()

                  if (!allCodeTypes.contains(codeType)) {
                     defaultCode = "no"
                     continue
                  }

                  if (procName.equals("createMultiEventProc")) {

                     createMultiEventProc(i, templatePath, appDir)
                     defaultCode = "no"
                  }

                  if (procName.equals("createMultiUrlProc")) {

                     createMultiUrlProc(i, templatePath, appDir)
                     defaultCode = "no"
                  }

                  if (procName.equals("createMultiFilesProc")) {

                     createMultiFilesProc(i, templatePath, appDir)
                     defaultCode = "no"
                  }

                  if (procName.equals("createMultiFunctionProc")) {

                     createMultiFunctionProc(i, templatePath, appDir, allCodeTypes)
                     defaultCode = "no"
                  }

                  if (procName.equals("createMultiFilesCodeTypeProc")) {

                     createMultiFilesCodeTypeProc(i, templatePath, appDir, codeType)
                     defaultCode = "no"
                  }

               }
           }

           if (defaultCode.equals("yes")) {
println "found default file " + i
             defaultCodeProc(i, templatePath, appDir)
           }
        }
     }
   }
}

createApp ( templatePath, appDir )
