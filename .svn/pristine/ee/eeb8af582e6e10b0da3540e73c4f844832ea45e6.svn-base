def createMultiUrlProc(fileName, thePath, theDir) {

    def theCode = new StringBuilder()
    def NL = System.lineSeparator()
    def char tab = '\t'
    def count = 0
    for (node in appApps.appsHome) {
        theCode.with {
            append "${tab}<td><a href='${node.@appsHomeURL}' class='app-link'>"
            append "<div class='app-item'>"
            append "<img border='0' src='resources/gfx/${node.@appsPng}' class='app-logo'/>"
            append "<span class='app-label'>${node.@appsDesc}</span>"
            append "</div></a></td>"
	    count++
	    if (count > 3) {
		append "</tr><tr>${NL}${NL}"
		count = 0
	    } else {
		append "${NL}${NL}"
	    }
        }
    }

    def oldFilePath = thePath + "/" + fileName
    def newFilePath = theDir + "/" + fileName

    def oldFile = new File(oldFilePath).text
    def newFile = ""

    if (oldFile.contains("___JSP_HOME_URLS___")) {
       newFile = oldFile.replaceAll("___JSP_HOME_URLS___", theCode)
    }

    new File(newFilePath).write(newFile)

}



def createEventCode(appEvent, appEventCode) {

   def char myReturn = '\r'
   def char newLine = '\n'
   def codeType = appEventCode.'@codeType'
   def myCode = ""

   if (codeType == "Event") {
      def theCode = ""
      for ( cc in appEventCode.code ) {

         def int x = cc.'@indent' as int
         def indent = ""
         while ( x-- > 0 ) {
           indent = indent + " "
         }

         theCode = theCode + indent
         theCode = theCode + cc.text() + myReturn + newLine
      }

      def oldCode = theCode
      def newCode = ""

      newCode = oldCode.replaceAll("Eeeee", appEvent.'@eventName')
      oldCode = newCode
      newCode = oldCode.replaceAll("Edddd", appEvent.'@eventDescription')
      oldCode = newCode

      newCode = oldCode.replaceAll("LLLLL", "<")
      oldCode = newCode
      newCode = oldCode.replaceAll("GGGGG", ">")
      oldCode = newCode

      myCode = myCode + newCode
   }

   if (codeType == "Parameter") {
      for ( p in appEvent.eventParameter ) {

         def theCode = ""
         for ( cc in appEventCode.code ) {

            def int x = cc.'@indent' as int
            def indent = ""
            while ( x-- > 0 ) {
              indent = indent + " "
            }

            theCode = theCode + indent
            theCode = theCode + cc.text() + myReturn + newLine
         }

         def oldCode = theCode
         def newCode = ""

         newCode = oldCode.replaceAll("Eeeee", appEvent.'@eventName')
         oldCode = newCode
         newCode = oldCode.replaceAll("Edddd", appEvent.'@eventDescription')
         oldCode = newCode

         newCode = oldCode.replaceAll("Ppppp", p.'@parameterName')
         oldCode = newCode
         newCode = oldCode.replaceAll("Pdddd", p.'@parameterDescription')
         oldCode = newCode
         newCode = oldCode.replaceAll("Prrrr", p.'@parameterRequired')

         oldCode = newCode
         newCode = oldCode.replaceAll("LLLLL", "<")
         oldCode = newCode
         newCode = oldCode.replaceAll("GGGGG", ">")
         oldCode = newCode

         myCode = myCode + newCode
      }
   }

   myCode
}




def createMultiEventProc(fileName, thePath, theDir) {

   for ( e in appEvents.appEvent ) {

      newFileName = fileName.replaceAll("Eeeee", e.'@eventName')

      def oldFilePath = thePath + "/" + fileName
      def newFilePath = theDir + "/" + newFileName

      def oldFile = new File(oldFilePath).text
      def newFile = ""
      def cleanFile = ""
      def char myReturn = '\r'
      def char newLine = '\n'

      newFile = insertAppCopyrights(oldFile)
      oldFile = newFile
      newFile = insertAppAuthors(oldFile)
      oldFile = newFile
      newFile = insertAppNames(oldFile)
      oldFile = newFile
      newFile = insertAppPackages(oldFile)
      oldFile = newFile
      newFile = oldFile.replaceAll("Eeeee", e.'@eventName')
      oldFile = newFile
      newFile = oldFile.replaceAll("Edddd", e.'@eventDescription')
      oldFile = newFile

      for ( c in appEventCodes.appCode ) {
         def theCodeKey = c.'@codeKey'

         if (oldFile.contains(theCodeKey)) {
            def insertCode = createEventCode(e, c)
            newFile = oldFile.replaceAll(theCodeKey, insertCode)
            oldFile = newFile
         }

         for ( cc in appEventCodes.appCode ) {
            def theCodeKey2 = cc.'@codeKey'

            if (insertCode.contains(theCodeKey2)) {
               def insertCode2 = createEventCode(e, cc)
               newFile = oldFile.replaceAll(theCodeKey2, insertCode2)
               oldFile = newFile
            }
         }
      }

      new File(newFilePath).write(newFile)
   }
}





def loadJspListHeading(theTable) {

   def sortClass = []
   for ( t in appTables.appTable ) {
      def tableClass = t.'@className'
      if (tableClass.equals(theTable)) {

