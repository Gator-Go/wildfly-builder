
<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="ISO-8859-1"%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>

<script>
var Events = [];

function Event (id, name, description) {
    this.id = id;
    this.name = name;
    this.description = description;
}
Event.prototype.updateTo = function (name, description, soapRequest) {
    this.name = name;
    this.description = description;
    this.soapRequest = soapRequest;
}
</script>

<div class='pojo-section'>
<div class='pojo-section-header'>Add Subscription Item</div>
<div class='pojo-section-body'>
<div align="center">
  <form id="formAddSubscription" method="POST" action="do">
    <input type='hidden' id="opAddSubscription" name="op" value="">
    <input type='hidden' id="subscriptId" name="subscriptId" value="">
    <input type='hidden' id="nbrOp" name="nbrOp" value="${nbrOp}">
    <input type='hidden' name="returnOp" value="${returnOp}">
    <input type='hidden' name="returnAction" value="${returnAction}">

    <c:if test="${!empty msg}">
       <font class="pojo-msg-alert"><b>${msg}</b></font><br><br>
    </c:if>

    <br>
    <font class="Verdana" size="+1">User Info</font>
    <br>

    <div class="pojo-section-alternate">
    <c:if test="${!empty firstNameError}">
       <font class="pojo-msg-alert"><b>${firstNameError}</b></font><br><br>
    </c:if>
    First Name: <input type='text' name='firstName' value='${firstName}' size='70' maxlength='140'>
      <br><br>
    </div>

    <div class="pojo-section-body">
    <c:if test="${!empty lastNameError}">
       <font class="pojo-msg-alert"><b>${lastNameError}</b></font><br><br>
    </c:if>
    Last Name: <input type='text' name='lastName' value='${lastName}' size='70' maxlength='140'>
      <br><br>
    </div>

    <div class="pojo-section-alternate">
    <c:if test="${!empty emailError}">
       <font class="pojo-msg-alert"><b>${emailError}</b></font><br><br>
    </c:if>
    Email: <input type='text' name='email' value='${email}' size='70' maxlength='140'>
      <br><br>
    </div>

    <div class="pojo-section-body">
      Subscription Add: 
      <select id="eventSelect" name="eventSelect" onchange="goAddEvent()">
      <c:forEach items="${eventSelects}" var="item">
        <option value='<c:out value="${item.id}"/>' <c:out value="${item.selected}"/>><c:out value="${item.option}"/></option>
      </c:forEach>
      </select>
      <br><br>
    </div>


    <c:forEach items="${subscriptFmts}" var="item">
       <script>Events.push(new Event('${item.id}','${item.name}','${item.description}'));</script>
    </c:forEach>

    <br>
    <font class="Verdana" size="+1">User Subscriptions</font>
    <br>

    <table id="listtable" cellpadding="2" cellspacing="2" width="98%">
    <thead>
      <tr class="pojo-section-alternate">
      <th valign='top' width='5%'>Delete</th>
      <th valign='top' width='5%'>ID</th>
      <th valign='top' width='15%'>Name</th>
      <th valign='top' width='30%'>Description</th>
      </tr>
    </thead>
    <tbody id="events"></tbody>
    </table>

    <button class='btnAdd' id="add" type="button" onclick='goAddSubscription("${opAction}");'>Add</button>
    &nbsp;&nbsp;&nbsp;
    <button class='btnBack' id="back" type="button" onclick='goAddSubscription("${opBack}");'>Back</button>

  </form>
</div>

<script>

  showEvents();

  function goAddSubscription(op)
  {
    $('#opAddSubscription').val(op);
    $('#formAddSubscription').submit();
  }

  function goAddEvent()
  {
    $('#opAddSubscription').val("AddSubscriptionSelect");
    $('#subscriptId').val($('#eventSelect').val());
    $('#formAddSubscription').submit();
  }

  function goDeleteEvent(idx)
  {
    var nbrParm = $( '#nbrOp' ).val();
    var aNbrParm = parseInt(nbrParm) - 1;
    $( '#nbrOp' ).val(aNbrParm.toString());
    Events.splice(idx, 1);
    showEvents();
  }

  function showEvents() {
    var eventData = '';
    var aNbrParm = 0;

    $.each(Events, function( index, value)
    {
      aNbrParm = index + 1;
      var idIndex = "id" + index;
      var nameIndex = "name" + index;
      var descriptionIndex = "description" + index;

      eventData = eventData +
        '<tr>' +
        '<td align="center"><img onclick="javascript:goDeleteEvent(\'' + index +
             '\')" border="0" src="resources/gfx/delete.gif" alt="Delete" /></td>' +

        '<td align="center">' + value.id + '</td>' +
        '<input type="hidden" name="' + idIndex + '" value="' + value.id + '">' +

        '<td align="center">' + value.name + '</td>' +
        '<input type="hidden" name="' + nameIndex + '" value="' + value.name + '">' +

        '<td align="center">' + value.description + '</td>' +
        '<input type="hidden" name="' + descriptionIndex + '" value="' + value.description + '">'

    });
    $('#events').html(eventData);
    $( '#nbrOp' ).val(aNbrParm.toString());
  }

</script>
</div>
</div>
