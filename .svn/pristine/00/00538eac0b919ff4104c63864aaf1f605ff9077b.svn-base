            } else {

                yyyyyEdit.setDeviceId(deviceId);
                yyyyyEdit.setYyyyyId(yyyyyId);
                yyyyyEdit.setLastUpdate(lastUpdate);
                yyyyyEdit.setDeleteFlag(deleteFlag);

