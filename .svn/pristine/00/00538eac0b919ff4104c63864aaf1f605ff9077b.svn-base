/**
 * JAX-RS Example
 * 
 * This class produces a RESTful service to read the contents of the Yyyyy table.
 */
@Path("/syncYyyyys")
@RequestScoped
public class YyyyyRestSync {

    @Inject
    private Logger log;

    @Inject
    @XxxxxProperty(name = "Format.DateTimeStr")
    private String FormatDateTimeStr;

    @Inject
    YyyyyService yyyyyService;

    @Inject
    private Event<XxxxxAlertEvent> alertEventMsg;

___INJECT_REST_ONE2MANY_CHILD___
___INJECT_REST_ONE2MANY_CHILD_ALERT___

    private JSONObject jsonObject;
    private JSONArray jsonArray;
    private String tempDir = System.getProperty("ppp.ppp.ppp.temp.dir");

    @GET
    @Path("/{param}")
    @Produces("application/json")
    public Response printMessage(@PathParam("param") String syncYyyyys) {

	SimpleDateFormat formatDateTime = new SimpleDateFormat (FormatDateTimeStr);
        XxxxxAlertEvent alertEvent = new XxxxxAlertEvent();
        alertEvent.setName("alertEvent");
        alertEvent.setXxxxxAlertType("sync");
        alertEvent.setXxxxxAlertSource("YyyyyRestSync");
        alertEvent.setXxxxxAlertMessage(syncYyyyys);
        alertEvent.setOccurredAt(formatDateTime.format(new Date()));
        alertEventMsg.fire(alertEvent);

        String result = "Success";

        JSONArray jsonArray = new JSONArray(syncYyyyys);

        for (int i = 0; i < jsonArray.length(); i++) {
            jsonObject = jsonArray.getJSONObject(i);

            String deviceIdStr = jsonObject.getString("deviceId");
            Long deviceId = Long.parseLong(deviceIdStr);
            String yyyyyIdStr = jsonObject.getString("yyyyyId");
            Long yyyyyId = Long.parseLong(yyyyyIdStr);
            String lastUpdateStr = jsonObject.getString("lastUpdate");
            Long lastUpdateLong = new Long(lastUpdateStr);
            Date lastUpdate = new Date(lastUpdateLong.longValue());
            Boolean deleteFlag = new Boolean(false);
            String deleteFlagStr = jsonObject.getString("deleteFlag");
            if (deleteFlagStr.equals("1"))
                deleteFlag = new Boolean(true);

            Yyyyy yyyyyEdit = yyyyyService.getYyyyyByCloudId(deviceId, yyyyyId);

