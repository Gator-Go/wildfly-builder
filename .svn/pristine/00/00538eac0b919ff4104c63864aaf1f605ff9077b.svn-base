                Yyyyy yyyyy = new Yyyyy();
                yyyyy.setDeviceId(deviceId);
                yyyyy.setYyyyyId(yyyyyId);
                yyyyy.setLastUpdate(lastUpdate);
                yyyyy.setDeleteFlag(deleteFlag);

