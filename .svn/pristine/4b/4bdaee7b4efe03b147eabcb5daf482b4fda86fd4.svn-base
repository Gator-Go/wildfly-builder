package ppp.ppp.ppp.servlet.helper;

import ppp.ppp.ppp.entity.Yyyyy;
import ppp.ppp.ppp.settings.XxxxxProperty;

import java.text.SimpleDateFormat;
import java.text.DecimalFormat;
import java.util.ArrayList;
import java.util.List;

import javax.inject.Inject;
import javax.persistence.EntityManager;
import javax.enterprise.context.RequestScoped;

@RequestScoped
public class YyyyyString {

    @Inject
    @XxxxxProperty(name = "Format.DateStr")
    private String FormatDateStr;

    @Inject
    @XxxxxProperty(name = "Format.DateTimeStr")
    private String FormatDateTimeStr;

    @Inject
    private EntityManager em;

    public YyyyyString() {

    }

    public String getString(Yyyyy obj) {

        SimpleDateFormat formatDate = new SimpleDateFormat (FormatDateStr);
        SimpleDateFormat formatDateTime = new SimpleDateFormat (FormatDateTimeStr);

       String result = String.format(
       ___LOAD_LIST_FIELDS___
        );
       return result;
    }

    public ArrayList<String> getStringArray(ArrayList<Yyyyy> yyyyyValues) {

      ArrayList<String> yyyyysArray = new ArrayList<String>();

      for (Yyyyy yyyyy : yyyyyValues) {
        yyyyysArray.add(this.getString(yyyyy));
      }
      return yyyyysArray;
    }

    public ArrayList<YyyyyOption> loadYyyyyOptions(Long selected) {
      ArrayList<YyyyyOption> yyyyyOptions = new ArrayList<YyyyyOption>();
      List<Yyyyy> yyyyys = listAllYyyyys();

      boolean first = false;
      if (selected.longValue() == -1)
        first = true;

      if (selected.longValue() == -2) {
        YyyyyOption yyyyyOption = new YyyyyOption();
        yyyyyOption.setId(selected);
        yyyyyOption.setYyyyyOption("Pick One");
        yyyyyOption.setSelected("selected");
        yyyyyOptions.add(yyyyyOption);
      }

      for (Yyyyy yyyyy : yyyyys) {

        YyyyyOption yyyyyOption = new YyyyyOption();
        yyyyyOption.setId(yyyyy.getId());
        yyyyyOption.setYyyyyOption(getString(yyyyy));
        if (selected.equals(yyyyy.getId()))
          yyyyyOption.setSelected("selected");
        if (first) {
          yyyyyOption.setSelected("selected");
          first = false;
        }
        yyyyyOptions.add(yyyyyOption);
      }
      return yyyyyOptions;
    }

    private List<Yyyyy> listAllYyyyys() {
        @SuppressWarnings("unchecked")
        final List<Yyyyy> results = em.createQuery("select m from Yyyyy m where m.deleteFlag = FALSE order by m.id").getResultList();
        return results;
    }
}
