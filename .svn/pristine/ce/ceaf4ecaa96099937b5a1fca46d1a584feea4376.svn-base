
package ppp.ppp.ppp.event;

import ppp.ppp.ppp.service.EventService;
import ppp.ppp.ppp.entity.AdminEvent;
import ppp.ppp.ppp.entity.UserEmail;
import ppp.ppp.ppp.entity.UserSms;
import ppp.ppp.ppp.event.msg.EmailEvent;
import ppp.ppp.ppp.event.msg.SmsEvent;
import ppp.ppp.ppp.event.msg.SettingsEvent;
___EVENT_IMPORT_STRING___

import jakarta.ejb.Startup;
import jakarta.ejb.Singleton;
import jakarta.annotation.PostConstruct;
import jakarta.enterprise.context.ApplicationScoped;
import jakarta.enterprise.event.Observes;
import jakarta.enterprise.event.Event;
import jakarta.inject.Inject;

import java.text.ParseException;
import java.util.Date;
import java.util.logging.Logger;

@Singleton
@Startup
@ApplicationScoped
public class SubscriptionsListener {

    @Inject
    private Logger log;

    @Inject
    private EventService eventService;

    @Inject
    private Event<EmailEvent> emailEventMsg;

    @Inject
    private Event<SmsEvent> smsEventMsg;

    public void checkSettingsEvent(@Observes SettingsEvent settingsEvent) {

	String eventName = settingsEvent.getName();
        log.info("In the Subscriptions Listener " + eventName + " was received.");

        AdminEvent adminEvent = eventService.getAdminEventbyName(eventName);
        if (adminEvent == null) {
          log.warning("Event not in Event table - name = " + eventName);
          return;
        }

	String newline = "\t\n";
        String subject = eventName + " XXXXX Subscription Notice";
        String msg = eventName + " Data" + newline + newline
		"Key   : " + settingsEvent.getKey() + newline +
		"Value : " + settingsEvent.getValue();

        for (UserEmail userEmail : adminEvent.getUserEmail()) {
	    fireEmailEvent(userEmail.getEmail(), subject, msg);
        }

        for (UserSms userSms : adminEvent.getUserSms()) {
	    fireSmsEvent(userSms.getSms(), subject, msg);
        }
    }
___EVENT_OBSERVES_STRING___

    private void fireEmailEvent(String userEmail, String subject, String msg) {
        
          EmailEvent emailEvent = new EmailEvent();
          emailEvent.setName("EmailEvent");
          emailEvent.setTo(userEmail);
          emailEvent.setSubject(subject);
          emailEvent.setMessage(msg);
          emailEventMsg.fire(emailEvent);
    }

    private void fireSmsEvent(String userSms, String subject, String msg) {
        
          SmsEvent smsEvent = new SmsEvent();
          smsEvent.setName("SmsEvent");
          smsEvent.setTo(userSms);
          smsEvent.setMessage(subject + " : " + msg);
          smsEventMsg.fire(smsEvent);
    }

    @PostConstruct
    public void logStart() {

        log.info("@PostConstruct:Subscriptions Event Listener Started");
    }
}
