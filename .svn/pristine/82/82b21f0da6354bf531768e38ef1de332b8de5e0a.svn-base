
package ppp.ppp.ppp.event;

import ppp.ppp.ppp.event.msg.EmailEvent;

import jakarta.mail.Address;
import jakarta.mail.Message;
import jakarta.mail.MessagingException;
import jakarta.mail.Session;
import jakarta.mail.Transport;
import jakarta.mail.internet.AddressException;
import jakarta.mail.internet.InternetAddress;
import jakarta.mail.internet.MimeMessage;

import jakarta.ejb.Startup;
import jakarta.ejb.Singleton;
import jakarta.annotation.PostConstruct;
import jakarta.annotation.Resource;
import jakarta.enterprise.context.ApplicationScoped;
import jakarta.enterprise.event.Observes;
import jakarta.inject.Inject;

import java.text.ParseException;
import java.util.Date;
import java.util.logging.Logger;

@Singleton
@Startup
@ApplicationScoped
public class EmailListener {

    @Inject
    private Logger log;

    @Resource(name = "java:jboss/mail/gmail-outgoing")
    private Session sessionSend;

    public void onEmailEvent(@Observes EmailEvent emailEvent) {

        log.info("In the Email Listener " + emailEvent.getName() + " was received.");
        
        final StringBuffer messageText = new StringBuffer();
        String message = emailEvent.getMessage();
        if (message != null && !message.trim().isEmpty() ) {
            messageText.append(message);
        }
        
        String to = emailEvent.getTo();
        Address[] addressesTO = parseAddresses(to);

        String cc = emailEvent.getCc();
        Address[] addressesCC = parseAddresses(cc);

        String bcc = emailEvent.getBcc();
        Address[] addressesBCC = parseAddresses(bcc);

        String subject = emailEvent.getSubject();

        try {
            
	    Message mimeMsg = new MimeMessage(sessionSend);
        
            // add [to] addresses
            if (addressesTO != null && addressesTO.length > 0){
                mimeMsg.addRecipients(Message.RecipientType.TO, addressesTO);
            }
            
            // add [cc] addresses
            if (addressesCC != null && addressesCC.length > 0){
                mimeMsg.addRecipients(Message.RecipientType.CC, addressesCC);
            }
            
            // add [bcc] addresses
            if (addressesBCC != null && addressesBCC.length > 0){
                mimeMsg.addRecipients(Message.RecipientType.BCC, addressesBCC);
            }
            
            mimeMsg.setSubject(subject);
            mimeMsg.setText(messageText.toString());
            Transport.send(mimeMsg);
            
        } 
        catch (MessagingException ex) 
        {
            //problem sending the message
            String msg = "Problem sending the email on gmail server : " + ex.toString();
            log.warning(msg);
        }
        
    }
    
    /**
     * Parses email address separated with a comma into a valid array of 
     * jakarta.mail.Address
     * @param addresses the comma separated list of addresses
     * @return the array of qualified Address objects
     */
    protected Address[] parseAddresses(final String addresses)
    {
        Address[] ret = null;
        
        if (addresses != null && !addresses.trim().isEmpty() )
        {
            final String[] parts = addresses.split("\\s*[,;]+\\s*");
            if (parts.length > 0)
            {
                ret = new Address[parts.length];
                int i = 0;
                for (String a : parts) 
                {
                    // the true enforces extra email address validation
                    try {
                      ret[i++] = new InternetAddress(a, true);
                    } 
                    catch (AddressException ex) 
                    {
                      //problem with address validation
                      String msg = "Problem with address validation : " + a +
                         "  Exception : " + ex.toString();
                      log.warning(msg);
                    }
                }// for
            
            }// if
            
        }// if
        
        if (ret == null) {
            ret = new Address[0];
        }
        
        return ret;        
    }



    @PostConstruct
    public void logStart() {

        log.info("@PostConstruct:Email Event Listener Started");
    }
}
