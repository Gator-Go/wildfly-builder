package ppp.ppp.ppp.servlet.helper;

import ppp.ppp.ppp.service.EventService;
import ppp.ppp.ppp.entity.AdminEvent;
import ppp.ppp.ppp.entity.EventSchedule;
import ppp.ppp.ppp.entity.EventParameter;

import java.text.ParseException;
import java.util.Date;
import java.util.Iterator;
import java.util.List;
import java.util.ArrayList;
import java.util.Map;
import java.util.Collection;

import javax.servlet.http.HttpServletRequest;
import javax.enterprise.context.RequestScoped;
import javax.inject.Inject;

/**
 * This class provides common methods to manage data in the ScienceManagerServlet.
 *
 * @author Ron Kanengieter
 * @author <a href="mailto:ron@usgs.gov">Ron Kanengieter</a>
 * @author <a href="mailto:kpostma@usgs.gov">Kory Postma</a>
 * @version 1.0
 * @version $Id$
 */
@RequestScoped
public class EventDataHelper
{

    @Inject
    private EventService eventService;

   /**
    * This method loads one page of AdminEvent list data from the total search result list.
    *
    * @param requests A List object containing the total data list.
    * @param page the page that the user wants.
    * @param rowsToPage the number of rows per page.
    * @param nbrOfRows the number of rows in total list.
    *
    * @return <code>List<AdminEvent></code> one page of list SeasonalityChild objects.
    */
   public List<AdminEventFmt> loadAdminEventPage(List<AdminEvent> adminEvents, int page, int rowsToPage, int nbrOfRows)
   {
      List<AdminEventFmt> adminEventPage = new ArrayList();

      int index = (page - 1) * rowsToPage;
      for(int x = 0; x < rowsToPage && index < nbrOfRows; x = x+1) {
         AdminEventFmt adminEventFmt = new AdminEventFmt();
         AdminEvent adminEvent = adminEvents.get(index);

         adminEventFmt.setId(adminEvent.getId());
         adminEventFmt.setName(adminEvent.getName());
         adminEventFmt.setDescription(adminEvent.getDescription());
         if (adminEvent.getEventSchedule() != null) {
            if (adminEvent.getEventSchedule().getEnabled().booleanValue() == true)
               adminEventFmt.setEnabledFlag("true");
         }

         adminEventPage.add(adminEventFmt);
         index++;
      }
      return adminEventPage;
   }


   /**
    * This method loads LandDatabase default data to the req attributes.
    *
    * @param req A HttpServletRequest object to be loaded with default data.
    */
   public void loadDefaultEventData(HttpServletRequest req)
   {
      req.setAttribute("name", "");
      req.setAttribute("description", "");
      List<ParameterFmt> parameterFmts = new ArrayList<ParameterFmt>();
      req.setAttribute("parameterFmts", parameterFmts);
      String paramSize = "" + parameterFmts.size();
      req.setAttribute("nbrParam", paramSize);
   }


   /**
    * This method loads LandDatabase req parameter data to the req attribute date.
    * Would be used after an error and to re-show the data entered on the form.
    *
    * @param req A HttpServletRequest object to be loaded with parameter data.
    */
   public void loadEventDataFromReq(HttpServletRequest req)
   {
      req.setAttribute("id", req.getParameter("id"));
      req.setAttribute("name", req.getParameter("name"));
      req.setAttribute("description", req.getParameter("description"));
      List<ParameterFmt> parameterFmts = new ArrayList<ParameterFmt>();
      int paramRows = Integer.parseInt(req.getParameter("nbrParam"));
      for ( int x = 0; x < paramRows; x++) {
        String deleteFlag = "false";
        String deleteId = "deleteFlag" + x;
        String delete = req.getParameter(deleteId);
        if (delete != null && delete.equals("true"))
          deleteFlag = "true";

        String idId = "id" + x;
        String id = req.getParameter(idId);

        String requiredFlag = "false";
        String requiredId = "required" + x;
        String required = req.getParameter(requiredId);
        if (required != null && required.equals("true"))
          requiredFlag = "true";

        String nameId = "name" + x;
        String name = req.getParameter(nameId);

        String descriptionId = "description" + x;
        String description = req.getParameter(descriptionId);

        String fireValueId = "fireValue" + x;
        String fireValue = req.getParameter(fireValueId);

        ParameterFmt parameterFmt = new ParameterFmt();
        parameterFmt.setDeleteFlag(deleteFlag);
        parameterFmt.setId(id);
        parameterFmt.setRequired(requiredFlag);
        parameterFmt.setName(name);
        parameterFmt.setDescription(description);
        parameterFmt.setFireValue(fireValue);
        parameterFmts.add(parameterFmt);
      }
      req.setAttribute("parameterFmts", parameterFmts);
      String paramSize = "" + parameterFmts.size();
      req.setAttribute("nbrParam", paramSize);
   }


   /**
    * This method loads data from a req object to a AdminEvent object.
    *
    * @param adminEvent A AdminEvent object to be loaded with data.
    * @param req A HttpServletRequest object containing the data.
    */
   public void loadAdminEventAdd(AdminEvent adminEvent, HttpServletRequest req)
   {

      if(!req.getParameter("name").isEmpty())
      {
         String name = req.getParameter("name");
         adminEvent.setName(name);
      }

      if(!req.getParameter("description").isEmpty())
      {
         String description = req.getParameter("description");
         adminEvent.setDescription(description);
      }

      Collection<EventParameter> eventParameterColl = new ArrayList<EventParameter>();
      int paramRows = Integer.parseInt(req.getParameter("nbrParam"));
      for ( int x = 0; x < paramRows; x++) {
        EventParameter eventParameter = new EventParameter();
        String requiredFlag = "false";
        String requiredId = "required" + x;
        String required = req.getParameter(requiredId);
        if (required != null && required.equals("true"))
          requiredFlag = "true";
        eventParameter.setRequired(new Boolean(requiredFlag));

        String nameId = "name" + x;
        String name = req.getParameter(nameId);
        eventParameter.setName(name);

        String descriptionId = "description" + x;
        String description = req.getParameter(descriptionId);
        eventParameter.setDescription(description);

        eventParameterColl.add(eventParameter);
      }
      adminEvent.setEventParameter(eventParameterColl);
   }

   /**
    * This method loads data from a req object to a AdminEvent object.
    *
    * @param adminEvent A AdminEvent object to be loaded with data.
    * @param req A HttpServletRequest object containing the data.
    */
   public String deleteUpdateParameters(AdminEvent adminEvent, HttpServletRequest req)
   {

      Collection<EventParameter> eventParameterColl = new ArrayList<EventParameter>();
      int paramRows = Integer.parseInt(req.getParameter("nbrParam"));
      for ( int x = 0; x < paramRows; x++) {

        EventParameter eventParameter = new EventParameter();
        String idId = "id" + x;
        String id = req.getParameter(idId);
        Long longId = null;
        if (id != null && !id.trim().isEmpty()) {
           longId = Long.parseLong(req.getParameter(idId));
           eventParameter.setId(longId);
        }

        String deleteId = "deleteFlag" + x;
        String deleteFlag = req.getParameter(deleteId);
        if (deleteFlag != null && deleteFlag.equals("true")) {
          String result = eventService.deleteEventParameter(longId);
          if (!result.equals("Success"))
            return result;
          continue;
        }

        String requiredFlag = "false";
        String requiredId = "required" + x;
        String required = req.getParameter(requiredId);
        if (required != null && required.equals("true"))
          requiredFlag = "true";
        eventParameter.setRequired(new Boolean(requiredFlag));

        String nameId = "name" + x;
        String name = req.getParameter(nameId).trim();
        eventParameter.setName(name);

        String descriptionId = "description" + x;
        String description = req.getParameter(descriptionId);
        eventParameter.setDescription(description);

        eventParameter.setAdminEvent(adminEvent);

        eventParameterColl.add(eventParameter);

        if (longId != null) {
           String result = eventService.editEventParameter(eventParameter);
           if (!result.equals("Success"))
             return result;
        } else {
           Long returnId = eventService.addEventParameter(eventParameter);
        }

      }
      adminEvent.setEventParameter(eventParameterColl);
      return "Success";
   }

   /**
    * This method loads data from a req object to a AdminEvent object.
    *
    * @param adminEvent A AdminEvent object to be loaded with data.
    * @param req A HttpServletRequest object containing the data.
    */
   public void loadAdminEventUpdate(AdminEvent adminEvent, HttpServletRequest req)
   {

      if(!req.getParameter("name").isEmpty())
      {
         String name = req.getParameter("name");
         adminEvent.setName(name);
      }

      if(!req.getParameter("description").isEmpty())
      {
         String description = req.getParameter("description");
         adminEvent.setDescription(description);
      }


   }

   /**
    * This method loads data from a AdminEvent object to a req object.
    *
    * @param adminEvent A AdminEvent object containing the data.
    * @param req A HttpServletRequest object to be loaded with data.
    */
   public void loadEventFormData(AdminEvent adminEvent, HttpServletRequest req)
   {
      req.setAttribute("id", adminEvent.getId().toString());
      req.setAttribute("name", adminEvent.getName());
      req.setAttribute("description", adminEvent.getDescription());
      List<ParameterFmt> parameterFmts = new ArrayList<ParameterFmt>();
      Collection<EventParameter> eventParameterColl = adminEvent.getEventParameter();
      Iterator <EventParameter> i = eventParameterColl.iterator();
      while(i.hasNext())
      {
         EventParameter eventParameter = i.next();
         ParameterFmt parameterFmt = new ParameterFmt();
         parameterFmt.setDeleteFlag("false");
         parameterFmt.setId(eventParameter.getId().toString());
         parameterFmt.setRequired(eventParameter.getRequired().toString());
         parameterFmt.setName(eventParameter.getName());
         parameterFmt.setDescription(eventParameter.getDescription());
         parameterFmt.setFireValue("");
         parameterFmts.add(parameterFmt);
      }
      req.setAttribute("parameterFmts", parameterFmts);
      String paramSize = "" + parameterFmts.size();
      req.setAttribute("nbrParam", paramSize);
   }


   /**
    * This method loads Fire Event default data to the req attributes.
    *
    * @param req A HttpServletRequest object to be loaded with default data.
    */
   public void loadFireEventData(HttpServletRequest req)
   {

      List<Option> names = new ArrayList<Option>();
      List<AdminEvent> adminEvents = eventService.findAllAdminEvents();
      Iterator <AdminEvent> i = adminEvents.iterator();
      while(i.hasNext())
      {
         boolean firstTime = true;
         AdminEvent adminEvent = i.next();
         Option option = new Option();
         option.setOption(adminEvent.getName());
         if (firstTime) {
           option.setSelected("selected");
           firstTime = false;
         }
         names.add(option);
      }
      req.setAttribute("names", names);
   }



   /**
    * This method loads Event Schedule default data to the req attributes.
    *
    * @param req A HttpServletRequest object to be loaded with default data.
    */
   public void loadDefaultScheduleEventData(HttpServletRequest req, AdminEvent adminEvent)
   {
      req.setAttribute("id", adminEvent.getId().toString());
      req.setAttribute("second", "*");
      req.setAttribute("minute", "*");
      req.setAttribute("hour", "*");
      req.setAttribute("dom", "*");
      req.setAttribute("month", "*");
      req.setAttribute("dow", "*");
      req.setAttribute("year", "*");
      req.setAttribute("enabled", "false");
      req.setAttribute("enabledBox", "");
   }

   /**
    * This method loads Event Schedule default data to the req attributes.
    *
    * @param req A HttpServletRequest object to be loaded with default data.
    */
   public void loadScheduleEventData(HttpServletRequest req, AdminEvent adminEvent)
   {
      req.setAttribute("id", adminEvent.getId().toString());

      String schedule = adminEvent.getEventSchedule().getSchedule();
      String[] parts = schedule.split(" ");
      req.setAttribute("second", parts[0]);
      req.setAttribute("minute", parts[1]);
      req.setAttribute("hour", parts[2]);
      req.setAttribute("dom", parts[3]);
      req.setAttribute("month", parts[4]);
      req.setAttribute("dow", parts[5]);
      req.setAttribute("year", parts[6]);

      if (adminEvent.getEventSchedule().getEnabled().booleanValue() == true) {
         req.setAttribute("enabled", "true");
         req.setAttribute("enabledBox", "checked");
      } else {
         req.setAttribute("enabled", "false");
         req.setAttribute("enabledBox", "");
      }
   }


   /**
    * This method loads LandDatabase req parameter data to the req attribute date.
    * Would be used after an error and to re-show the data entered on the form.
    *
    * @param req A HttpServletRequest object to be loaded with parameter data.
    */
   public void loadEventScheduleFromReq(HttpServletRequest req)
   {
      req.setAttribute("id", req.getParameter("id"));
      req.setAttribute("second", req.getParameter("second"));
      req.setAttribute("minute", req.getParameter("minute"));
      req.setAttribute("hour", req.getParameter("hour"));
      req.setAttribute("dom", req.getParameter("dom"));
      req.setAttribute("month", req.getParameter("month"));
      req.setAttribute("dow", req.getParameter("dow"));
      req.setAttribute("year", req.getParameter("year"));
      String enabled = req.getParameter("enabled");
      if (enabled == null) {
         req.setAttribute("enabled", "false");
         req.setAttribute("enabledBox", "");
      } else {
         req.setAttribute("enabled", "true");
         req.setAttribute("enabledBox", "checked");
      }
   }


   /**
    * This method loads data from a req object to a AdminEvent object.
    *
    * @param adminEvent A AdminEvent object to be loaded with data.
    * @param req A HttpServletRequest object containing the data.
    */
   public void loadAdminEventSchedule(EventSchedule eventSchedule, HttpServletRequest req, AdminEvent adminEvent)
   {
      eventSchedule.setAdminEvent(adminEvent);
      String second = req.getParameter("second");
      String minute = req.getParameter("minute");
      String hour = req.getParameter("hour");
      String dom = req.getParameter("dom");
      String month = req.getParameter("month");
      String dow = req.getParameter("dow");
      String year = req.getParameter("year");
      String schedule = second + " " + minute + " " + hour + " " + dom + " " + month + " " + dow + " " + year;
      eventSchedule.setSchedule(schedule);

      String enabled = req.getParameter("enabled");
      if (enabled == null) {
         eventSchedule.setEnabled(new Boolean("false"));
      } else {
         eventSchedule.setEnabled(new Boolean("true"));
      }

      eventSchedule.setLastRun(new Date());
      eventSchedule.setMessage("N/A");

   }

   /**
    * This method loads data from a req object to a AdminEvent object.
    *
    * @param adminEvent A AdminEvent object to be loaded with data.
    * @param req A HttpServletRequest object containing the data.
    */
   public void loadParameterMap(HttpServletRequest req, Map<String, String> parameterData)
   {
      String message = req.getParameter("message");
      if (message != null && !message.trim().isEmpty())
        parameterData.put("message", message);

      int paramRows = Integer.parseInt(req.getParameter("nbrParam"));
      for ( int x = 0; x < paramRows; x++) {

        String nameId = "name" + x;
        String name = req.getParameter(nameId);

        String fireValueId = "fireValue" + x;
        String fireValue = req.getParameter(fireValueId);

        parameterData.put(name, fireValue);
      }
   }

}
