    <code indent='0'>___PARAMETER_INITIALIZER_STRING___</code>
    <code indent='12'>adminEvent.setEventParameter(eventParameterColl);</code>
    <code indent='12'>Long adminEventId = eventService.addAdminEvent(adminEvent);</code>
    <code indent='12'>if (adminEventId > 0)</code>
    <code indent='16'>log.info("=== Eeeee Created ===");</code>
