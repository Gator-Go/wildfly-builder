  <appCode codeKey='___EVENT_OBSERVES_STRING___' codeType='Event'>
    <code indent='0'></code>
    <code indent='4'>public void checkEeeee(@Observes Eeeee eeeee) {</code>
    <code indent='8'>String eventName = eeeee.getName();</code>
    <code indent='8'>log.info("In the Subscriptions Listener " + eventName + " was received.");</code>
    <code indent='8'>AdminEvent adminEvent = eventService.getAdminEventbyName(eventName);</code>
    <code indent='8'>if (adminEvent == null) {</code>
    <code indent='12'>log.warning("Event not in Event table - name = " + eventName);</code>
    <code indent='12'>return;</code>
    <code indent='8'>}</code>
    <code indent='8'>String subject = eventName + " XXXXX Subscription Notice";</code>
    <code indent='8'>String msg = eventName + " Data + newline + newline</code>
    <code indent='12'>"Message: " + eeeee.getMessage() + newline +</code>
    <code indent='0'>___PARAMETER_MESSAGE_STRING___</code>
    <code indent='12'>"";</code>
    <code indent='8'>for (UserEmail userEmail : adminEvent.getUserEmail()) {</code>
    <code indent='12'>fireEmailEvent(userEmail.getEmail(), subject, msg);</code>
    <code indent='8'>}</code>
    <code indent='8'>for (UserSms userSms : adminEvent.getUserSms()) {</code>
    <code indent='12'>fireSmsEvent(userSms.getSms(), subject, msg);</code>
    <code indent='8'>}</code>
    <code indent='4'>}</code>
  </appCode>

