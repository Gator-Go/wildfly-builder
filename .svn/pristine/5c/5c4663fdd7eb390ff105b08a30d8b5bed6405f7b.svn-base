import groovy.xml.XmlParser
import groovy.xml.XmlUtil

// Read XML files
def APP_APPS = new File("./APP_APPS.xml").text
def APP_HOME = new File("./APP_HOME.xml").text
def appApps = new XmlParser().parseText(APP_APPS)
def appHome = new XmlParser().parseText(APP_HOME)

def appFound = false
def appChanged = false
def one = 1

for (a in appApps.appsHome) {
    if (a.@appsName == appHome.home.@appName) {
        appFound = true
        if (one > 1) {
            println "ERROR: more than one ${a.@appsName} in APP_APPS.xml"
            System.exit(1)
        }
        one++
        if (a.@appsDesc == appHome.home.@appDesc &&
            a.@appsPng  == appHome.home.@appPng &&
            a.@appsHomeURL == appHome.home.@appHomeURL) {
            appChanged = false
        } else {
            appChanged = true
            a.@appsDesc     = appHome.home.@appDesc
            a.@appsPng      = appHome.home.@appPng
            a.@appsHomeURL  = appHome.home.@appHomeURL
        }
    }
}

if (appFound) {
    if (appChanged) {
        new File("./APP_APPS.xml").write(XmlUtil.serialize(appApps))
        println "APP_APPS.xml updated"
    } else {
        println "APP_APPS.xml up-to-date"
    }
} else {
    appApps.appendNode('appsHome', [
        appsName    : appHome.home.@appName,
        appsDesc    : appHome.home.@appDesc,
        appsPng     : appHome.home.@appPng,
        appsHomeURL : appHome.home.@appHomeURL
    ])
    new File("./APP_APPS.xml").write(XmlUtil.serialize(appApps))
    println "APP_APPS.xml updated"
}